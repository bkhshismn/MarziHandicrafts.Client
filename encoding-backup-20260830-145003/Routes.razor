@using Microsoft.AspNetCore.Components.Authorization
@using Marzi.Client.Shared.Layouts
@using Marzi.Client.Web.Authentication
@using Microsoft.AspNetCore.Components.Web

@inject AuthenticationStateProvider AuthenticationStateProvider

<CascadingAuthenticationState>

    <Router AppAssembly="@typeof(Program).Assembly"
            AdditionalAssemblies="new[] { typeof(MainLayout).Assembly }">

        <Found Context="routeData">

            <AuthorizeRouteView RouteData="@routeData"
                                DefaultLayout="@typeof(MainLayout)">

                <NotAuthorized>
                    <LayoutView Layout="@typeof(MainLayout)">
                        <p>
                            برای مشاهده این صفحه باید وارد شوید.
                        </p>

                        <a href="/login">
                            ورود
                        </a>
                    </LayoutView>
                </NotAuthorized>

                <Authorizing>
                    <p>
                        در حال بررسی وضعیت ورود...
                    </p>
                </Authorizing>

            </AuthorizeRouteView>

            <FocusOnNavigate RouteData="@routeData"
                             Selector="h1" />

        </Found>

        <NotFound>

            <LayoutView Layout="@typeof(MainLayout)">
                <p>
                    صفحه مورد نظر پیدا نشد.
                </p>
            </LayoutView>

        </NotFound>

    </Router>

</CascadingAuthenticationState>


@code {

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
            return;

        if (AuthenticationStateProvider
            is CustomAuthenticationStateProvider provider)
        {
            await provider.InitializeAsync();
        }
    }

}