@page "/portfolio/{Id:guid}"

@using Marzi.Client.Core.Models.Portfolio
@using Marzi.Client.Infrastructure.Services
@using Marzi.Client.Shared.Components.Gallery
@using Marzi.Client.Shared.Components.Portfolio

@inject PortfolioService PortfolioService
@inject ISnackbar Snackbar

@if (_loading)
{
    <div class="portfolio-page">

        <MudSkeleton Height="520px"
                     Animation="Animation.Wave"
                     Class="details-loading" />

    </div>
}
else if (_item is null)
{
    <div class="portfolio-page">

        <MudAlert Severity="Severity.Error">

            @(_error ?? "نمونه کار پیدا نشد.")

        </MudAlert>

    </div>
}
else
{
    <div class="portfolio-page">

        <MudGrid Spacing="4"
                 Class="portfolio-details-grid">

            <MudItem xs="12"
                     lg="7">

                <MudPaper Class="gallery-section"
                          Elevation="0">

                    <ImageGallery Images="_item.Images" />

                </MudPaper>

            </MudItem>

            <MudItem xs="12"
                     lg="5">

                <MudPaper Class="info-section"
                          Elevation="0">

                    <PortfolioInfo Item="_item" />

                </MudPaper>

            </MudItem>

        </MudGrid>


        <MudDivider Class="section-divider" />


        <MudStack Row="true"
                  Justify="Justify.SpaceBetween"
                  AlignItems="AlignItems.Center"
                  Class="section-header">

            <div>

                <MudText Typo="Typo.h4">
                    آثار مرتبط
                </MudText>

                <MudText Typo="Typo.body2"
                         Color="Color.Secondary">

                    آثار مشابه از همین دسته

                </MudText>

            </div>

            @if (_related.Any())
            {
                <MudChip T="string"
                         Color="Color.Primary"
                         Variant="Variant.Outlined">

                    @_related.Count اثر

                </MudChip>
            }

        </MudStack>


        @if (_related.Any())
        {
            <MudGrid Spacing="3"
                     Class="related-grid">

                @foreach (var item in _related)
                {
                    <MudItem xs="12"
                             sm="6"
                             md="4">

                        <PortfolioCard Item="item" />

                    </MudItem>
                }

            </MudGrid>
        }
        else
        {
            <MudAlert Severity="Severity.Info"
                      Class="related-empty">

                اثر مرتبطی پیدا نشد.

            </MudAlert>
        }

    </div>
}


@code {

    [Parameter]
    public Guid Id { get; set; }

    private PortfolioItemDto? _item;

    private List<PortfolioItemDto> _related = [];

    private bool _loading = true;

    private string? _error;


    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;

        _item = null;
        _related = [];

        try
        {
            _item =
                await PortfolioService.GetByIdAsync(Id);

            if (_item is null)
            {
                _error = "نمونه کار پیدا نشد.";
                return;
            }

            var items =
                await PortfolioService.GetPublishedAsync();

            _related = items
                .Where(x =>
                    x.Id != _item.Id &&
                    string.Equals(
                        x.Category,
                        _item.Category,
                        StringComparison.OrdinalIgnoreCase))
                .Take(3)
                .ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;

            Snackbar.Add(
                ex.Message,
                Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

}