@using MudBlazor
@using Microsoft.AspNetCore.Components.Authorization

<AuthorizeView Roles="Admin,Instructor">
    <Authorized Context="staffContext">
<div class="admin-mobile-bottom-navigation">
    <AuthorizeView Roles="Admin">
        <Authorized Context="adminContext">
    <MudButton Href="/admin"
               Class="admin-mobile-nav-item"
               Variant="Variant.Text"
               Color="Color.Inherit"
               StartIcon="@Icons.Material.Filled.Dashboard">

        <span>داشبورد</span>

    </MudButton>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="Admin">
        <Authorized Context="adminContext">
            <MudButton Href="/admin/users" Class="admin-mobile-nav-item" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.ManageAccounts"><span>کاربران</span></MudButton>
            <MudButton Href="/admin/categories" Class="admin-mobile-nav-item" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Category"><span>دسته‌ها</span></MudButton>
            <MudButton Href="/admin/system" Class="admin-mobile-nav-item" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Dns"><span>سرور</span></MudButton>
            <MudButton Href="/admin/analytics" Class="admin-mobile-nav-item" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Insights"><span>آمار</span></MudButton>
        </Authorized>
    </AuthorizeView>

    <MudButton Href="/admin/courses"
               Class="admin-mobile-nav-item"
               Variant="Variant.Text"
               Color="Color.Inherit"
               StartIcon="@Icons.Material.Filled.School">

        <span>دوره/ویدئو</span>

    </MudButton>

    <AuthorizeView Roles="Admin">
        <Authorized Context="adminContext">

    <MudButton Href="/admin/orders"
               Class="admin-mobile-nav-item"
               Variant="Variant.Text"
               Color="Color.Inherit"
               StartIcon="@Icons.Material.Filled.ShoppingCart">

        <span>سفارش‌ها</span>

    </MudButton>
        </Authorized>
    </AuthorizeView>


    <MudButton Href="/admin/portfolio"
               Class="admin-mobile-nav-item"
               Variant="Variant.Text"
               Color="Color.Inherit"
               StartIcon="@Icons.Material.Filled.Palette">

        <span>نمونه‌کارها</span>

    </MudButton>

    <MudButton Href="/"
               Class="admin-mobile-nav-item"
               Variant="Variant.Text"
               Color="Color.Inherit"
               StartIcon="@Icons.Material.Filled.Home">

        <span>سایت</span>

    </MudButton>

    <MudButton Href="/profile"
               Class="admin-mobile-nav-item"
               Variant="Variant.Text"
               Color="Color.Inherit"
               StartIcon="@Icons.Material.Filled.Person">

        <span>پروفایل</span>

    </MudButton>


    <MudButton Class="admin-mobile-nav-item"
               Variant="Variant.Text"
               Color="Color.Inherit"
               StartIcon="@Icons.Material.Filled.Logout"
               OnClick="LogoutAsync">

        <span>خروج</span>

    </MudButton>

</div>
    </Authorized>
</AuthorizeView>


@code {

    [Inject]
    private Marzi.Client.Infrastructure.Services.AuthService AuthService { get; set; } = default!;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;


    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();

        NavigationManager.NavigateTo(
            "/",
            forceLoad: true);
    }

}
