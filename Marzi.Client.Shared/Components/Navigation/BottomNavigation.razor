@using MudBlazor
@using Microsoft.AspNetCore.Components.Authorization

<div class="bottom-nav">

    <NavLink href="/"
             Match="NavLinkMatch.All"
             class="nav-link">

        <MudIcon Icon="@Icons.Material.Filled.Home"
                 Size="Size.Small" />

        <span>خانه</span>

    </NavLink>


    <NavLink href="/courses"
             class="nav-link">

        <MudIcon Icon="@Icons.Material.Filled.School"
                 Size="Size.Small" />

        <span>آموزش</span>

    </NavLink>


    <NavLink href="/portfolio"
             class="nav-link">

        <MudIcon Icon="@Icons.Material.Filled.Palette"
                 Size="Size.Small" />

        <span>نمونه‌کار</span>

    </NavLink>


    <NavLink href="/orders"
             class="nav-link">

        <MudIcon Icon="@Icons.Material.Filled.ShoppingBag"
                 Size="Size.Small" />

        <span>سفارش</span>

    </NavLink>


    <AuthorizeView>
        <Authorized>
            <NavLink href="/profile"
                     class="nav-link">
                <MudIcon Icon="@Icons.Material.Filled.Person"
                         Size="Size.Small" />
                <span>پروفایل</span>
            </NavLink>
        </Authorized>
        <NotAuthorized>
            <NavLink href="/login"
                     class="nav-link">
                <MudIcon Icon="@Icons.Material.Filled.Login"
                         Size="Size.Small" />
                <span>ورود</span>
            </NavLink>
        </NotAuthorized>
    </AuthorizeView>

</div>