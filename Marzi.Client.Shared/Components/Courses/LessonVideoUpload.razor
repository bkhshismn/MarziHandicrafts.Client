    // =========================================================
    // Upload progress
    // =========================================================

    private void ResetUploadProgress()
    {
        _uploadLoaded = 0;

        _uploadTotal = _selectedFileSize;

        _uploadSpeedBps = 0;

        _uploadPercent = 0;

        _uploadEta = TimeSpan.Zero;

        _uploadStartedUtc = DateTime.UtcNow;

        _lastProgressRenderUtc = DateTime.MinValue;
    }

    [JSInvokable]
    public Task OnUploadProgress(long loaded, long total)
    {
        if (!_uploading)
            return Task.CompletedTask;

        _uploadLoaded = Math.Max(0, loaded);

        _uploadTotal = total > 0
            ? total
            : Math.Max(_uploadLoaded, 1);

        _uploadPercent = (int)Math.Clamp(
            _uploadLoaded * 100 / _uploadTotal,
            0,
            100);

        var elapsed =
            (DateTime.UtcNow - _uploadStartedUtc).TotalSeconds;

        if (elapsed > 0.5 && _uploadLoaded > 0)
        {
            _uploadSpeedBps = _uploadLoaded / elapsed;

            var remaining =
                Math.Max(0, _uploadTotal - _uploadLoaded);

            _uploadEta = _uploadSpeedBps > 1
                ? TimeSpan.FromSeconds(remaining / _uploadSpeedBps)
                : TimeSpan.Zero;
        }

        var now = DateTime.UtcNow;

        // حداکثر چهار بار در ثانیه رندر می‌کنیم تا مدار اشباع نشود.
        if ((now - _lastProgressRenderUtc).TotalMilliseconds < 250)
            return Task.CompletedTask;

        _lastProgressRenderUtc = now;

        return InvokeAsync(StateHasChanged);
    }

    private async Task<bool> TryDetectCompletedUploadAsync()
    {
        var previousId = _latestEpisode?.Id;

        for (var attempt = 0; attempt < 10; attempt++)
        {
            try
            {
                await Task.Delay(TimeSpan.FromSeconds(3));

                await LoadExistingVideos();

                if (_latestEpisode is not null &&
                    _latestEpisode.Id != previousId)
                {
                    return true;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine(
                    $"[LESSON VIDEO] Completion check failed: {ex.Message}");
            }
        }

        return false;
    }


    // =========================================================
    // Formatting
    // =========================================================

    private static string FormatSpeed(double bytesPerSecond) =>
        bytesPerSecond <= 0
            ? "—"
            : bytesPerSecond >= 1024 * 1024
                ? $"{bytesPerSecond / (1024d * 1024d):0.##} MB/s"
                : $"{bytesPerSecond / 1024d:0.#} KB/s";

    private static string FormatEta(TimeSpan eta)
    {
        if (eta <= TimeSpan.Zero)
            return "—";

        if (eta.TotalHours >= 1)
            return $"حدود {eta.Hours} ساعت و {eta.Minutes} دقیقه";

        if (eta.TotalMinutes >= 1)
            return $"حدود {eta.Minutes} دقیقه و {eta.Seconds} ثانیه";

        return $"حدود {Math.Max(1, (int)eta.TotalSeconds)} ثانیه";
    }

    private static string FormatFileSize(
        long bytes)
    {
        if (bytes < 1024)
            return $"{bytes} B";

        if (bytes < 1024 * 1024)
            return $"{bytes / 1024d:0.##} KB";

        if (bytes < 1024L * 1024L * 1024L)
            return $"{bytes / 1024d / 1024d:0.##} MB";

        return
            $"{bytes / 1024d / 1024d / 1024d:0.##} GB";
    }


    private static string FormatDuration(
        int seconds)
    {
        if (seconds <= 0)
            return "مدت نامشخص";

        var time =
            TimeSpan.FromSeconds(
                seconds);

        if (time.TotalHours >= 1)
        {
            return
                $"{(int)time.TotalHours:00}:{time.Minutes:00}:{time.Seconds:00}";
        }

        return
            $"{time.Minutes:00}:{time.Seconds:00}";
    }


