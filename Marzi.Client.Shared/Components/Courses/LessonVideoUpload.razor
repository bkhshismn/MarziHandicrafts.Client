@using Marzi.Client.Core.Authentication
@using Marzi.Client.Core.Models.Courses
@using Marzi.Client.Infrastructure.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Configuration
@using Microsoft.JSInterop
@using MudBlazor

@inject CourseEpisodeService EpisodeService
@inject ISnackbar Snackbar
@inject IConfiguration Configuration
@inject IJSRuntime JS
@inject ITokenStorage TokenStorage

<MudPaper Class="admin-lesson-video-upload pa-4"
          Elevation="0">

    <!-- ========================================================= -->
    <!-- Header -->
    <!-- ========================================================= -->

    <MudStack Row="true"
              AlignItems="AlignItems.Center"
              Spacing="2"
              Class="mb-4">

        <MudIcon Icon="@Icons.Material.Filled.VideoFile"
                 Color="Color.Primary" />

        <MudText Typo="Typo.h6">

            آپلود ویدئوی درس

        </MudText>

    </MudStack>


    <!-- ========================================================= -->
    <!-- Lesson Info -->
    <!-- ========================================================= -->

    <MudText Typo="Typo.caption"
             Color="Color.Secondary"
             Class="mb-3">

        @Lesson.Title

    </MudText>


    <!-- ========================================================= -->
    <!-- Existing Video -->
    <!-- ========================================================= -->
    @if (_loadingExistingVideo)
    {
        <MudAlert Severity="Severity.Info"
                  Variant="Variant.Outlined"
                  Class="mb-4">

            <MudStack Row="true"
                      AlignItems="AlignItems.Center"
                      Spacing="2">

                <MudProgressCircular Size="Size.Small"
                                     Indeterminate="true" />

                <span>
                    در حال بررسی ویدئوی این درس...
                </span>

            </MudStack>

        </MudAlert>
    }


    @if (!_loadingExistingVideo && _episodes.Count > 0)
    {
        <MudStack Spacing="2" Class="mb-4">
            @foreach (var episode in _episodes.OrderBy(x => x.Order).ToList())
            {
                <MudPaper Class="pa-3" Elevation="1">
                    <MudStack Spacing="2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.subtitle2">@($"{episode.Order}. {episode.Title}")</MudText>
                            <MudChip T="string" Size="Size.Small" Color="@(IsReady(episode) ? Color.Success : IsProcessing(episode) ? Color.Warning : Color.Default)">@episode.Status</MudChip>
                        </MudStack>
                        @if (!string.IsNullOrWhiteSpace(episode.Description))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@episode.Description</MudText>
                        }
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            @if (episode.IsFree)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Info">پیش‌نمایش رایگان</MudChip>
                            }
                            @if (episode.DurationSeconds > 0)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@FormatDuration(episode.DurationSeconds)</MudChip>
                            }
                        </MudStack>
                        @if (IsProcessing(episode))
                        {
                            <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
                        }
                        <MudStack Row="true" Spacing="2" Class="admin-video-actions">
                            @if (IsReady(episode))
                            {
                                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="@(() => ShowPreview(episode))">پخش</MudButton>
                            }
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit" OnClick="@(() => BeginEditEpisode(episode))">ویرایش</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="@(() => DeleteEpisodeAsync(episode))" Disabled="_deletingEpisode">حذف</MudButton>
                        </MudStack>
                        @if (_editingEpisodeId == episode.Id)
                        {
                            <MudDivider />
                            <MudTextField @bind-Value="_editTitle" Label="عنوان ویدیو" Variant="Variant.Outlined" />
                            <MudTextField @bind-Value="_editDescription" Label="توضیحات" Variant="Variant.Outlined" />
                            <MudNumericField T="int" @bind-Value="_editOrder" Label="ترتیب" Min="1" Variant="Variant.Outlined" />
                            <MudCheckBox T="bool" @bind-Value="_editIsFree" Label="پیش‌نمایش رایگان" />
                            <MudStack Row="true" Spacing="2">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveEpisodeEditAsync" Disabled="_savingEpisode">ذخیره تغییرات</MudButton>
                                <MudButton Variant="Variant.Text" OnClick="CancelEpisodeEdit">انصراف</MudButton>
                            </MudStack>
                        }
                    </MudStack>
                </MudPaper>
            }
        </MudStack>
    }
    @if (_previewLesson is not null)
    {
        <MudPaper Class="admin-video-preview pa-3 mb-4"
                  Elevation="1">

            <MudStack Spacing="2">

                <MudStack Row="true"
                          AlignItems="AlignItems.Center"
                          Justify="Justify.SpaceBetween">

                    <MudText Typo="Typo.subtitle2">
                        پیش‌نمایش ویدئو
                    </MudText>

                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                   Color="Color.Default"
                                   Size="Size.Small"
                                   OnClick="HidePreview" />

                </MudStack>

                <VideoPlayer Lesson="_previewLesson"
                             ApiBaseUrl="@ApiBaseUrl" />

            </MudStack>

        </MudPaper>
    }


    <!-- ========================================================= -->
    <!-- Upload Form -->
    <!-- ========================================================= -->

    <MudStack Spacing="3">

        <!-- عنوان خودکار: از نام درس و ترتیب ساخته می‌شود -->

        <MudAlert Severity="Severity.Info"
                  Variant="Variant.Outlined"
                  Dense="true">

            عنوان این ویدیو خودکار ثبت می‌شود:
            <strong>@_episodeTitle</strong>

        </MudAlert>


        <!-- Free Preview -->

        <MudCheckBox T="bool"
                     @bind-Value="_isFree"
                     Label="پیش‌نمایش رایگان"
                     Color="Color.Primary"
                     Disabled="_uploading" />


        <!-- File -->

        <div>

            <MudText Typo="Typo.body2"
                     Class="mb-2">

                فایل ویدئو

            </MudText>

            <input type="file"
                   accept="video/*"
                   class="mobile-file-input"
                   @ref="_fileInput"
                   @onchange="OnFileSelected" />

        </div>


        <!-- Selected File -->
        @if (_hasSelectedFile)
        {
            <MudPaper Class="pa-3"
                      Elevation="0">

                <MudStack Row="true"
                          AlignItems="AlignItems.Center"
                          Justify="Justify.SpaceBetween">

                    <MudStack Row="true"
                              AlignItems="AlignItems.Center"
                              Spacing="2">

                        <MudIcon Icon="@Icons.Material.Filled.Movie"
                                 Color="Color.Primary" />

                        <div>

                            <MudText Typo="Typo.body2">

                                @_selectedFileName

                            </MudText>

                            <MudText Typo="Typo.caption"
                                     Color="Color.Secondary">

                                @FormatFileSize(
                                    _selectedFileSize)

                            </MudText>

                        </div>

                    </MudStack>


                    @if (!_uploading)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="ClearFile" />
                    }

                </MudStack>

            </MudPaper>
        }


        <!-- Error -->
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error"
                      Variant="Variant.Outlined">

                @_error

            </MudAlert>
        }


        <!-- Upload Progress -->
        @if (_uploading)
        {
            <MudPaper Class="pa-4" Elevation="0">

                <MudStack Spacing="2">

                    <MudStack Row="true"
                              AlignItems="AlignItems.Center"
                              Justify="Justify.SpaceBetween">

                        <MudText Typo="Typo.body2">

                            در حال آپلود ویدئو...

                        </MudText>

                        <MudText Typo="Typo.body2" Color="Color.Primary">

                            @_uploadPercent٪

                        </MudText>

                    </MudStack>

                    <MudProgressLinear Value="@_uploadPercent"
                                       Color="Color.Primary"
                                       Rounded="true" />

                    <MudStack Row="true"
                              Justify="Justify.SpaceBetween">

                        <MudText Typo="Typo.caption" Color="Color.Secondary">

                            @FormatFileSize(_uploadLoaded) از @FormatFileSize(_uploadTotal)

                        </MudText>

                        <MudText Typo="Typo.caption" Color="Color.Secondary">

                            سرعت: @FormatSpeed(_uploadSpeedBps)

                        </MudText>

                        <MudText Typo="Typo.caption" Color="Color.Secondary">

                            زمان باقی‌مانده: @FormatEta(_uploadEta)

                        </MudText>

                    </MudStack>

                    <MudText Typo="Typo.caption" Color="Color.Secondary">

                        پس از پایان آپلود، پردازش ویدئو روی سرور انجام می‌شود.

                    </MudText>

                </MudStack>

            </MudPaper>
        }


        <!-- Upload Button -->

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   StartIcon="@Icons.Material.Filled.CloudUpload"
                   OnClick="UploadVideo"
                   Disabled="@(!CanUpload)">

            @if (_uploading)
            {
                <MudProgressCircular Size="Size.Small"
                                     Indeterminate="true" />
            }

            @if (!_uploading)
            {
                <span>
                    آپلود ویدئو
                </span>
            }

        </MudButton>

        @if (!_hasSelectedFile && !_uploading)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                برای فعال شدن دکمه، ابتدا فایل ویدیو را انتخاب کنید.
            </MudText>
        }

    </MudStack>

</MudPaper>


@code {

    // =========================================================
    // Parameters
    // =========================================================

    [Parameter]
    public CourseLessonDto Lesson { get; set; } = default!;


    [Parameter]
    public EventCallback<CourseEpisodeDto> OnUploaded { get; set; }


    // =========================================================
    // State
    // =========================================================

    private readonly List<CourseEpisodeDto> _episodes = [];

    private CourseEpisodeDto? _latestEpisode;

    // فایل مستقیماً از مرورگر به API فرستاده می‌شود (fetch + FormData)؛
    // خواندن فایل از طریق استریم Blazor روی اندروید با NotReadableError شکست می‌خورد.
    private ElementReference _fileInput;

    private IJSObjectReference? _uploadModule;

    private bool _hasSelectedFile;

    private string _selectedFileName = string.Empty;

    private long _selectedFileSize;

    // آمار زندهٔ آپلود برای نوار پیشرفت
    private DotNetObjectReference<LessonVideoUpload>? _dotNetReference;

    private long _uploadLoaded;

    private long _uploadTotal;

    private double _uploadSpeedBps;

    private int _uploadPercent;

    private TimeSpan _uploadEta;

    private DateTime _uploadStartedUtc;

    private DateTime _lastProgressRenderUtc;

    private bool _loadingExistingVideo;

    private bool _uploading;

    private int _order = 1;
    private string _episodeTitle = string.Empty;
    private string _episodeDescription = string.Empty;

    private bool _isFree;

    private string? _error;

    private CancellationTokenSource? _pollCancellation;

    private CourseLessonDto? _previewLesson;

    private bool _deletingEpisode;
    private Guid? _editingEpisodeId;
    private string _editTitle = string.Empty;
    private string _editDescription = string.Empty;
    private int _editOrder = 1;
    private bool _editIsFree;
    private bool _savingEpisode;

    private string ApiBaseUrl =>
        Configuration["Media:PublicBaseUrl"]
        ?? Configuration["Api:BaseUrl"]
        ?? string.Empty;

    // با هر تغییر در videoUpload.js این مقدار را بالا ببر؛ وگرنه مرورگر/CDN
    // نسخهٔ کش‌شدهٔ قدیمی را اجرا می‌کند.
    private const string UploadModuleVersion = "20261020-3";

    private ValueTask<IJSObjectReference> GetUploadModuleAsync() =>
        JS.InvokeAsync<IJSObjectReference>(
            "import",
            $"./_content/Marzi.Client.Shared/js/videoUpload.js?v={UploadModuleVersion}");


    // =========================================================
    // Computed
    // =========================================================

    private bool CanUpload
    {
        get
        {
            if (_uploading)
                return false;

            if (!_hasSelectedFile)
                return false;

            if (string.IsNullOrWhiteSpace(_episodeTitle))
                return false;
            if (_order < 1)
                return false;

            return true;
        }
    }

    private void ShowPreview(CourseEpisodeDto episode)
    {
        if (!IsReady(episode))
            return;

        _previewLesson = new CourseLessonDto
        {
            Id = Lesson.Id,
            Title = Lesson.Title,
            Description = Lesson.Description,
            DurationSeconds = episode.DurationSeconds,
            IsFreePreview = episode.IsFree,
            OrderIndex = Lesson.OrderIndex,
            EpisodeId = episode.Id,
            VideoStatus = episode.Status.ToString(),
            HasVideo = true
        };
    }

    private void HidePreview()
    {
        _previewLesson = null;
    }

    private void BeginEditEpisode(CourseEpisodeDto episode)
    {
        _editingEpisodeId = episode.Id;
        _editTitle = episode.Title;
        _editDescription = episode.Description;
        _editOrder = episode.Order;
        _editIsFree = episode.IsFree;
    }

    private void CancelEpisodeEdit() => _editingEpisodeId = null;

    private async Task SaveEpisodeEditAsync()
    {
        if (_editingEpisodeId is not Guid episodeId || _savingEpisode)
            return;

        _savingEpisode = true;
        try
        {
            var updated = await EpisodeService.UpdateAsync(Lesson.Id, episodeId,
                new CourseEpisodeUpdateRequest
                {
                    Title = _editTitle,
                    Description = _editDescription,
                    Order = _editOrder,
                    IsFree = _editIsFree
                });
            var index = _episodes.FindIndex(x => x.Id == updated.Id);
            if (index >= 0)
                _episodes[index] = updated;
            _latestEpisode = _episodes.OrderByDescending(x => x.Order).FirstOrDefault();
            _editingEpisodeId = null;
            Snackbar.Add("تغییرات ویدیو ذخیره شد.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _savingEpisode = false;
        }
    }

    private async Task DeleteEpisodeAsync(CourseEpisodeDto episode)
    {
        if (_deletingEpisode)
            return;

        var confirmed = await JS.InvokeAsync<bool>("confirm", $"آیا ویدیوی «{episode.Title}» حذف شود؟");
        if (!confirmed)
            return;

        _deletingEpisode = true;
        try
        {
            await EpisodeService.DeleteAsync(Lesson.Id, episode.Id);
            if (_previewLesson?.EpisodeId == episode.Id)
                HidePreview();
            await LoadExistingVideos();
            Snackbar.Add("ویدیو حذف شد.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _deletingEpisode = false;
        }
    }
    // =========================================================
    // Initialize
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadExistingVideos();
    }


    // =========================================================
    // Load Existing Videos
    // =========================================================

    private async Task LoadExistingVideos()
    {
        _loadingExistingVideo = true;

        _error = null;

        try
        {
            var result =
                await EpisodeService.GetByLessonIdAsync(
                    Lesson.Id);

            _episodes.Clear();

            _episodes.AddRange(
                result.OrderBy(x => x.Order));

            _latestEpisode =
                _episodes
                    .OrderByDescending(x => x.Order)
                    .FirstOrDefault();


            if (_latestEpisode is not null)
            {
                Lesson.HasVideo = true;

                _order =
                    Math.Max(1, _episodes.Max(x => x.Order) + 1);
            }


            _episodeTitle = $"{Lesson.Title} - ویدیو {_order}";
            if (_latestEpisode is not null && IsProcessing(_latestEpisode))
                StartPolling(_latestEpisode.Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[LESSON VIDEO] Load existing videos failed: {ex}");

            _error =
                ex.Message;
        }
        finally
        {
            _loadingExistingVideo = false;
        }
    }


    // =========================================================
    // File Selected
    // =========================================================

    private async Task OnFileSelected()
    {
        _error = null;

        _hasSelectedFile = false;

        _selectedFileName = string.Empty;

        _selectedFileSize = 0;

        try
        {
            _uploadModule ??= await GetUploadModuleAsync();

            var info = await _uploadModule.InvokeAsync<SelectedFileInfo?>(
                "getSelectedFile",
                _fileInput);

            if (info is null)
                return;

            // فایل‌های ابری/گالری روی اندروید گاهی فقط متادیتا دارند و
            // خواندن محتوا شکست می‌خورد؛ قبل از آپلود بررسی می‌کنیم.
            // اگر نسخهٔ ماژول قدیمی باشد این تابع نیست؛ در آن صورت رد می‌شویم.
            try
            {
                var probe = await _uploadModule.InvokeAsync<ReadableProbe?>(
                    "verifyReadable",
                    _fileInput);

                if (probe is not null && !probe.Ok)
                {
                    Console.WriteLine(
                        $"[LESSON VIDEO] File content not readable: {probe.Error}");

                    _error =
                        "مرورگر نمی‌تواند محتوای این فایل را بخواند. " +
                        "فایل را در حافظهٔ گوشی ذخیره کن یا فایل دیگری انتخاب کن.";

                    return;
                }
            }
            catch (JSException ex)
            {
                Console.WriteLine(
                    $"[LESSON VIDEO] Readability probe unavailable: {ex.Message}");
            }

            _selectedFileName =
                string.IsNullOrWhiteSpace(info.Name)
                    ? "video"
                    : info.Name;

            _selectedFileSize = info.Size;

            _hasSelectedFile = true;

            Console.WriteLine(
                $"[LESSON VIDEO] File selected: {_selectedFileName} ({_selectedFileSize} bytes)");
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[LESSON VIDEO] File selection failed: {ex}");

            _error =
                "مرورگر نتوانست فایل انتخاب‌شده را بخواند. " +
                "لطفاً فایل را دوباره انتخاب کنید.";
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }


    // =========================================================
    // Clear File
    // =========================================================

    private async Task ClearFile()
    {
        if (_uploading)
            return;

        _hasSelectedFile = false;

        _selectedFileName = string.Empty;

        _selectedFileSize = 0;

        _error = null;

        try
        {
            if (_uploadModule is not null)
            {
                await _uploadModule.InvokeVoidAsync(
                    "clearInput",
                    _fileInput);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[LESSON VIDEO] Clear input failed: {ex}");
        }
    }


    // =========================================================
    // Upload
    // =========================================================

    private async Task UploadVideo()
    {
        if (!CanUpload)
            return;

        _uploading = true;

        _error = null;

        ResetUploadProgress();

        try
        {
            var token = await TokenStorage.GetAccessTokenAsync();

            if (string.IsNullOrWhiteSpace(token))
            {
                throw new InvalidOperationException(
                    "برای آپلود ویدئو باید وارد حساب کاربری شوید.");
            }

            var uploadUrl =
                $"{ApiBaseUrl.TrimEnd('/')}/api/admin/lessons/{Lesson.Id}/video";

            var healthUrl =
                $"{ApiBaseUrl.TrimEnd('/')}/api/courses/published";

            _uploadModule ??= await GetUploadModuleAsync();

            Console.WriteLine(
                $"[LESSON VIDEO] Uploading to {uploadUrl}");

            _dotNetReference ??= DotNetObjectReference.Create(this);

            // فایل مستقیماً از مرورگر به API می‌رود؛ هیچ بایتی از SignalR
            // عبور نمی‌کند تا خطای NotReadableError اندروید تکرار نشود.
            var result = await _uploadModule.InvokeAsync<VideoUploadResult>(
                "uploadVideo",
                _fileInput,
                uploadUrl,
                token,
                _episodeTitle.Trim(),
                _episodeDescription.Trim(),
                _order,
                _isFree,
                healthUrl,
                _dotNetReference);

            Console.WriteLine(
                $"[LESSON VIDEO] Upload status: {result?.Status}");

            if (result is null || result.Status != 200)
            {
                Console.WriteLine(
                    $"[LESSON VIDEO] Response body: {result?.Body}");

                throw new InvalidOperationException(
                    result?.Status switch
                    {
                        401 or 403 =>
                            "دسترسی لازم برای آپلود را ندارید؛ دوباره وارد شوید.",
                        413 =>
                            "حجم فایل بیشتر از حد مجاز سرور است.",
                        -2 =>
                            "اتصال به سرور برقرار نشد. اینترنت گوشی را بررسی کن و دوباره تلاش کن.",
                        -1 =>
                            "آپلود قطع شد؛ معمولاً به‌خاطر خوانده‌نشدن فایل توسط مرورگر. " +
                            "فایل را دوباره انتخاب کن.",
                        _ =>
                            $"آپلود ویدئو ناموفق بود. کد: {result?.Status}"
                    });
            }

            _hasSelectedFile = false;

            _selectedFileName = string.Empty;

            _selectedFileSize = 0;

            await _uploadModule.InvokeVoidAsync(
                "clearInput",
                _fileInput);

            Snackbar.Add(
                "ویدئو با موفقیت آپلود شد و پردازش آن آغاز شد.",
                Severity.Success);

            Lesson.HasVideo = true;

            // لیست به‌روزرسانی و در صورت لزوم polling پردازش آغاز می‌شود.
            await LoadExistingVideos();

            if (_latestEpisode is not null)
            {
                await OnUploaded.InvokeAsync(
                    _latestEpisode);
            }

            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
            // اگر مدار Blazor قطع شود، انتظار برای نتیجه لغو می‌شود ولی
            // آپلود در مرورگر ادامه دارد؛ چند بار لیست را چک می‌کنیم.
            Console.WriteLine(
                "[LESSON VIDEO] Await canceled; checking if upload completed anyway.");

            if (await TryDetectCompletedUploadAsync())
            {
                Snackbar.Add(
                    "ویدئو با موفقیت آپلود شد و پردازش آن آغاز شد.",
                    Severity.Success);

                return;
            }

            _error =
                "ارتباط صفحه قطع شد و نتیجهٔ آپلود مشخص نیست. " +
                "صفحه را دوباره باز کن و ببین ویدئو در لیست اضافه شده یا نه.";
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[LESSON VIDEO] Upload failed: {ex}");

            _error =
                ex.Message;

            Snackbar.Add(
                ex.Message,
                Severity.Error);
        }
        finally
        {
            _uploading = false;
        }
    }


    // =========================================================
    // Polling
    // =========================================================

    private void StartPolling(
        Guid episodeId)
    {
        _pollCancellation?.Cancel();

        _pollCancellation?.Dispose();

        _pollCancellation =
            new CancellationTokenSource();

        var token =
            _pollCancellation.Token;

        _ = PollStatusAsync(
            episodeId,
            token);
    }


    private async Task PollStatusAsync(
        Guid episodeId,
        CancellationToken cancellationToken)
    {
        try
        {
            for (var i = 0; i < 120; i++)
            {
                if (cancellationToken.IsCancellationRequested)
                    return;

                await Task.Delay(
                    TimeSpan.FromSeconds(3),
                    cancellationToken);


                CourseEpisodeDto status;

                try
                {
                    status =
                        await EpisodeService.GetStatusAsync(
                            Lesson.Id,
                            episodeId);
                }
                catch (Exception ex)
                {
                    Console.WriteLine(
                        $"[LESSON VIDEO] Status check failed: {ex}");

                    continue;
                }


                _latestEpisode =
                    status;


                var existing =
                    _episodes.FindIndex(
                        x => x.Id == status.Id);

                if (existing >= 0)
                {
                    _episodes[existing] =
                        status;
                }
                else
                {
                    _episodes.Add(
                        status);
                }


                if (IsReady(status))
                {
                    Lesson.HasVideo = true;

                    await InvokeAsync(
                        StateHasChanged);

                    Snackbar.Add(
                        "ویدئو با موفقیت پردازش شد و آماده پخش است.",
                        Severity.Success);

                    return;
                }


                if (IsFailed(status))
                {
                    await InvokeAsync(
                        StateHasChanged);

                    Snackbar.Add(
                        "پردازش ویدئو با خطا مواجه شد.",
                        Severity.Error);

                    return;
                }


                await InvokeAsync(
                    StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // طبیعی است.
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[LESSON VIDEO] Polling failed: {ex}");
        }
    }


    // =========================================================
    // Status Helpers
