@using Marzi.Client.Core.Models.Courses
@using Marzi.Client.Infrastructure.Services
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor

@inject CourseEpisodeService EpisodeService
@inject ISnackbar Snackbar

<MudPaper Class="admin-lesson-video-upload pa-4"
          Elevation="0">

    <!-- ========================================================= -->
    <!-- Header -->
    <!-- ========================================================= -->

    <MudStack Row="true"
              AlignItems="AlignItems.Center"
              Spacing="2"
              Class="mb-4">

        <MudIcon Icon="@Icons.Material.Filled.VideoFile"
                 Color="Color.Primary" />

        <MudText Typo="Typo.h6">

            آپلود ویدئوی درس

        </MudText>

    </MudStack>


    <!-- ========================================================= -->
    <!-- Lesson Info -->
    <!-- ========================================================= -->

    <MudText Typo="Typo.caption"
             Color="Color.Secondary"
             Class="mb-3">

        @Lesson.Title

    </MudText>


    <!-- ========================================================= -->
    <!-- Existing Video -->
    <!-- ========================================================= -->
    @if (_loadingExistingVideo)
    {
        <MudAlert Severity="Severity.Info"
                  Variant="Variant.Outlined"
                  Class="mb-4">

            <MudStack Row="true"
                      AlignItems="AlignItems.Center"
                      Spacing="2">

                <MudProgressCircular Size="Size.Small"
                                     Indeterminate="true" />

                <span>
                    در حال بررسی ویدئوی این درس...
                </span>

            </MudStack>

        </MudAlert>
    }


    @if (!_loadingExistingVideo && _episodes.Count > 0)
    {
        <MudPaper Class="pa-3 mb-4"
                  Elevation="1">

            <MudStack Spacing="2">

                <MudStack Row="true"
                          AlignItems="AlignItems.Center"
                          Justify="Justify.SpaceBetween">

                    <MudText Typo="Typo.subtitle2">

                        ویدئوی درس

                    </MudText>


                    @if (IsReady(_latestEpisode))
                    {
                        <MudChip T="string"
                                 Color="Color.Success"
                                 Size="Size.Small">

                            آماده پخش

                        </MudChip>
                    }


                    @if (IsProcessing(_latestEpisode))
                    {
                        <MudChip T="string"
                                 Color="Color.Warning"
                                 Size="Size.Small">

                            در حال پردازش

                        </MudChip>
                    }


                    @if (!IsReady(_latestEpisode) &&
                         !IsProcessing(_latestEpisode))
                    {
                        <MudChip T="string"
                                 Color="Color.Default"
                                 Size="Size.Small">

                            @_latestEpisode!.Status

                        </MudChip>
                    }

                </MudStack>


                @if (_latestEpisode is not null)
                {
                    <MudText Typo="Typo.body2">

                        @_latestEpisode.Title

                    </MudText>


                    @if (!string.IsNullOrWhiteSpace(
                        _latestEpisode.Description))
                    {
                        <MudText Typo="Typo.caption"
                                 Color="Color.Secondary">

                            @_latestEpisode.Description

                        </MudText>
                    }


                    <MudStack Row="true"
                              Spacing="2"
                              AlignItems="AlignItems.Center">

                        <MudChip T="string"
                                 Size="Size.Small"
                                 Variant="Variant.Outlined">

                            ترتیب @_latestEpisode.Order

                        </MudChip>


                        @if (_latestEpisode.IsFree)
                        {
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Color="Color.Info">

                                پیش‌نمایش رایگان

                            </MudChip>
                        }


                        @if (_latestEpisode.DurationSeconds > 0)
                        {
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="Variant.Outlined">

                                @FormatDuration(
                                    _latestEpisode.DurationSeconds)

                            </MudChip>
                        }

                    </MudStack>


                    @if (IsProcessing(_latestEpisode))
                    {
                        <MudProgressLinear Indeterminate="true"
                                           Color="Color.Warning"
                                           Class="mt-2" />

                        <MudText Typo="Typo.caption"
                                 Color="Color.Secondary">

                            ویدئو آپلود شده و سرور در حال تبدیل آن به فرمت پخش است.

                        </MudText>
                    }


                    @if (IsReady(_latestEpisode))
                    {
                        <MudAlert Severity="Severity.Success"
                                  Variant="Variant.Outlined">

                            ویدئو با موفقیت آماده پخش شده است.

                        </MudAlert>
                    }

                }

            </MudStack>

        </MudPaper>
    }


    <!-- ========================================================= -->
    <!-- Upload Form -->
    <!-- ========================================================= -->

    <MudStack Spacing="3">

        <!-- Video Title -->

        <MudTextField @bind-Value="_title"
                      Label="عنوان ویدئو *"
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      Required="true"
                      Disabled="_uploading" />


        <!-- Description -->

        <MudTextField @bind-Value="_description"
                      Label="توضیحات *"
                      Variant="Variant.Outlined"
                      Lines="3"
                      FullWidth="true"
                      Required="true"
                      Disabled="_uploading" />


        <!-- Order -->

        <MudNumericField T="int"
                         @bind-Value="_order"
                         Label="ترتیب"
                         Variant="Variant.Outlined"
                         Min="1"
                         FullWidth="true"
                         Disabled="_uploading" />


        <!-- Free Preview -->

        <MudCheckBox T="bool"
                     @bind-Value="_isFree"
                     Label="پیش‌نمایش رایگان"
                     Color="Color.Primary"
                     Disabled="_uploading" />


        <!-- File -->

        <div>

            <MudText Typo="Typo.body2"
                     Class="mb-2">

                فایل ویدئو

            </MudText>

            <InputFile OnChange="OnFileSelected"
                       accept="video/*"
                       disabled="@_uploading" />

        </div>


        <!-- Selected File -->
        @if (_selectedFile is not null)
        {
            <MudPaper Class="pa-3"
                      Elevation="0">

                <MudStack Row="true"
                          AlignItems="AlignItems.Center"
                          Justify="Justify.SpaceBetween">

                    <MudStack Row="true"
                              AlignItems="AlignItems.Center"
                              Spacing="2">

                        <MudIcon Icon="@Icons.Material.Filled.Movie"
                                 Color="Color.Primary" />

                        <div>

                            <MudText Typo="Typo.body2">

                                @_selectedFile.Name

                            </MudText>

                            <MudText Typo="Typo.caption"
                                     Color="Color.Secondary">

                                @FormatFileSize(
                                    _selectedFile.Size)

                            </MudText>

                        </div>

                    </MudStack>


                    @if (!_uploading)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="ClearFile" />
                    }

                </MudStack>

            </MudPaper>
        }


        <!-- Error -->
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error"
                      Variant="Variant.Outlined">

                @_error

            </MudAlert>
        }


        <!-- Upload Progress -->
        @if (_uploading)
        {
            <MudAlert Severity="Severity.Info"
                      Variant="Variant.Outlined">

                <MudStack Spacing="2">

                    <MudStack Row="true"
                              AlignItems="AlignItems.Center"
                              Spacing="2">

                        <MudProgressCircular Size="Size.Small"
                                             Indeterminate="true" />

                        <span>
                            در حال آپلود ویدئو...
                        </span>

                    </MudStack>

                    <MudText Typo="Typo.caption">

                        پس از پایان آپلود، پردازش ویدئو روی سرور انجام می‌شود.

                    </MudText>

                </MudStack>

            </MudAlert>
        }


        <!-- Upload Button -->

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   StartIcon="@Icons.Material.Filled.CloudUpload"
                   OnClick="UploadVideo"
                   Disabled="@(!CanUpload)">

            @if (_uploading)
            {
                <MudProgressCircular Size="Size.Small"
                                     Indeterminate="true" />
            }

            @if (!_uploading)
            {
                <span>
                    آپلود ویدئو
                </span>
            }

        </MudButton>

    </MudStack>

</MudPaper>


@code {

    // =========================================================
    // Parameters
    // =========================================================

    [Parameter]
    public CourseLessonDto Lesson { get; set; } = default!;


    [Parameter]
    public EventCallback<CourseEpisodeDto> OnUploaded { get; set; }


    // =========================================================
    // State
    // =========================================================

    private readonly List<CourseEpisodeDto> _episodes = [];

    private CourseEpisodeDto? _latestEpisode;

    private IBrowserFile? _selectedFile;

    private bool _loadingExistingVideo;

    private bool _uploading;

    private string _title = string.Empty;

    private string _description = string.Empty;

    private int _order = 1;

    private bool _isFree;

    private string? _error;

    private CancellationTokenSource? _pollCancellation;


    // =========================================================
    // Computed
    // =========================================================

    private bool CanUpload
    {
        get
        {
            if (_uploading)
                return false;

            if (_selectedFile is null)
                return false;

            if (string.IsNullOrWhiteSpace(_title))
                return false;

            if (string.IsNullOrWhiteSpace(_description))
                return false;

            if (_order < 1)
                return false;

            return true;
        }
    }


    // =========================================================
    // Initialize
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadExistingVideos();
    }


    // =========================================================
    // Load Existing Videos
    // =========================================================

    private async Task LoadExistingVideos()
    {
        _loadingExistingVideo = true;

        _error = null;

        try
        {
            var result =
                await EpisodeService.GetByLessonIdAsync(
                    Lesson.Id);

            _episodes.Clear();

            _episodes.AddRange(
                result.OrderBy(x => x.Order));

            _latestEpisode =
                _episodes
                    .OrderByDescending(x => x.Order)
                    .FirstOrDefault();


            if (_latestEpisode is not null)
            {
                Lesson.HasVideo = true;

                if (string.IsNullOrWhiteSpace(_title))
                {
                    _title =
                        _latestEpisode.Title;
                }

                if (string.IsNullOrWhiteSpace(_description))
                {
                    _description =
                        _latestEpisode.Description ?? string.Empty;
                }

                _order =
                    Math.Max(
                        1,
                        _latestEpisode.Order);
            }


            if (_latestEpisode is not null &&
                IsProcessing(_latestEpisode))
            {
                StartPolling(
                    _latestEpisode.Id);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[LESSON VIDEO] Load existing videos failed: {ex}");

            _error =
                ex.Message;
        }
        finally
        {
            _loadingExistingVideo = false;
        }
    }


    // =========================================================
    // File Selected
    // =========================================================

    private void OnFileSelected(
        InputFileChangeEventArgs e)
    {
        _error = null;

        try
        {
            _selectedFile =
                e.File;

            if (_selectedFile is null)
                return;

            Console.WriteLine(
                $"[LESSON VIDEO] File selected: {_selectedFile.Name}");

            Console.WriteLine(
                $"[LESSON VIDEO] File size: {_selectedFile.Size}");

            Console.WriteLine(
                $"[LESSON VIDEO] Content type: {_selectedFile.ContentType}");
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[LESSON VIDEO] File selection failed: {ex}");

            _selectedFile = null;

            _error =
                "انتخاب فایل ویدئو ناموفق بود.";
        }
    }


    // =========================================================
    // Clear File
    // =========================================================

    private void ClearFile()
    {
        if (_uploading)
            return;

        _selectedFile = null;

        _error = null;
    }


    // =========================================================
    // Upload
    // =========================================================

    private async Task UploadVideo()
    {
        if (!CanUpload)
            return;

        _uploading = true;

        _error = null;

        try
        {
            var file =
                _selectedFile!;

            Console.WriteLine(
                "[LESSON VIDEO] Starting upload...");

            Console.WriteLine(
                $"[LESSON VIDEO] LessonId: {Lesson.Id}");

            Console.WriteLine(
                $"[LESSON VIDEO] File: {file.Name}");

            Console.WriteLine(
                $"[LESSON VIDEO] Size: {file.Size}");

            await using var stream =
                file.OpenReadStream(
                    maxAllowedSize: 1024L * 1024L * 1024L);

            var episode =
                await EpisodeService.UploadAsync(
                    Lesson.Id,
                    _title.Trim(),
                    _description.Trim(),
                    _order,
                    _isFree,
                    stream,
                    file.Name,
                    file.ContentType);


            Console.WriteLine(
                $"[LESSON VIDEO] Upload response Id: {episode.Id}");

            Console.WriteLine(
                $"[LESSON VIDEO] Upload response Status: {episode.Status}");


            // =================================================
            // Update lesson immediately
            // =================================================

            Lesson.HasVideo = true;


            // =================================================
            // Update local episode list
            // =================================================

            _episodes.RemoveAll(
                x => x.Id == episode.Id);

            _episodes.Add(
                episode);

            _latestEpisode =
                _episodes
                    .OrderByDescending(x => x.Order)
                    .FirstOrDefault();


            _selectedFile = null;


            Snackbar.Add(
                "ویدئو با موفقیت آپلود شد و پردازش آن آغاز شد.",
                Severity.Success);


            // =================================================
            // Notify parent
            // =================================================

            await OnUploaded.InvokeAsync(
                episode);


            // =================================================
            // Poll processing status
            // =================================================

            if (IsProcessing(episode))
            {
                StartPolling(
                    episode.Id);
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[LESSON VIDEO] Upload failed: {ex}");

            _error =
                ex.Message;

            Snackbar.Add(
                ex.Message,
                Severity.Error);
        }
        finally
        {
            _uploading = false;
        }
    }


    // =========================================================
    // Polling
    // =========================================================

    private void StartPolling(
        Guid episodeId)
    {
        _pollCancellation?.Cancel();

        _pollCancellation?.Dispose();

        _pollCancellation =
            new CancellationTokenSource();

        var token =
            _pollCancellation.Token;

        _ = PollStatusAsync(
            episodeId,
            token);
    }


    private async Task PollStatusAsync(
        Guid episodeId,
        CancellationToken cancellationToken)
    {
        try
        {
            for (var i = 0; i < 120; i++)
            {
                if (cancellationToken.IsCancellationRequested)
                    return;

                await Task.Delay(
                    TimeSpan.FromSeconds(3),
                    cancellationToken);


                CourseEpisodeDto status;

                try
                {
                    status =
                        await EpisodeService.GetStatusAsync(
                            Lesson.Id,
                            episodeId);
                }
                catch (Exception ex)
                {
                    Console.WriteLine(
                        $"[LESSON VIDEO] Status check failed: {ex}");

                    continue;
                }


                _latestEpisode =
                    status;


                var existing =
                    _episodes.FindIndex(
                        x => x.Id == status.Id);

                if (existing >= 0)
                {
                    _episodes[existing] =
                        status;
                }
                else
                {
                    _episodes.Add(
                        status);
                }


                if (IsReady(status))
                {
                    Lesson.HasVideo = true;

                    await InvokeAsync(
                        StateHasChanged);

                    Snackbar.Add(
                        "ویدئو با موفقیت پردازش شد و آماده پخش است.",
                        Severity.Success);

                    return;
                }


                if (IsFailed(status))
                {
                    await InvokeAsync(
                        StateHasChanged);

                    Snackbar.Add(
                        "پردازش ویدئو با خطا مواجه شد.",
                        Severity.Error);

                    return;
                }


                await InvokeAsync(
                    StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // طبیعی است.
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[LESSON VIDEO] Polling failed: {ex}");
        }
    }


    // =========================================================
    // Status Helpers
    // =========================================================

    private static bool IsReady(
       CourseEpisodeDto? episode)
    {
        if (episode is null)
            return false;

        var status =
            episode.Status.ToString();

        return
            string.Equals(
                status,
                "Ready",
                StringComparison.OrdinalIgnoreCase)
            ||
            string.Equals(
                status,
                "Completed",
                StringComparison.OrdinalIgnoreCase);
    }


    private static bool IsProcessing(
        CourseEpisodeDto? episode)
    {
        if (episode is null)
            return false;

        var status =
            episode.Status.ToString();

        return
            string.Equals(
                status,
                "Processing",
                StringComparison.OrdinalIgnoreCase)
            ||
            string.Equals(
                status,
                "Pending",
                StringComparison.OrdinalIgnoreCase)
            ||
            string.Equals(
                status,
                "Queued",
                StringComparison.OrdinalIgnoreCase);
    }


    private static bool IsFailed(
        CourseEpisodeDto? episode)
    {
        if (episode is null)
            return false;

        var status =
            episode.Status.ToString();

        return
            string.Equals(
                status,
                "Failed",
                StringComparison.OrdinalIgnoreCase)
            ||
            string.Equals(
                status,
                "Error",
                StringComparison.OrdinalIgnoreCase);
    }


    // =========================================================
    // Formatting
    // =========================================================

    private static string FormatFileSize(
        long bytes)
    {
        if (bytes < 1024)
            return $"{bytes} B";

        if (bytes < 1024 * 1024)
            return $"{bytes / 1024d:0.##} KB";

        if (bytes < 1024L * 1024L * 1024L)
            return $"{bytes / 1024d / 1024d:0.##} MB";

        return
            $"{bytes / 1024d / 1024d / 1024d:0.##} GB";
    }


    private static string FormatDuration(
        int seconds)
    {
        if (seconds <= 0)
            return "مدت نامشخص";

        var time =
            TimeSpan.FromSeconds(
                seconds);

        if (time.TotalHours >= 1)
        {
            return
                $"{(int)time.TotalHours:00}:{time.Minutes:00}:{time.Seconds:00}";
        }

        return
            $"{time.Minutes:00}:{time.Seconds:00}";
    }


    // =========================================================
    // Dispose
    // =========================================================

    public void Dispose()
    {
        _pollCancellation?.Cancel();

        _pollCancellation?.Dispose();
    }

}