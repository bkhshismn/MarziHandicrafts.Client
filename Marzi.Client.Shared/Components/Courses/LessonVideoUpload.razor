@using Marzi.Client.Core.Models.Courses
@using Marzi.Client.Infrastructure.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Configuration
@using Microsoft.JSInterop
@using MudBlazor

@inject CourseEpisodeService EpisodeService
@inject ISnackbar Snackbar
@inject IConfiguration Configuration
@inject IJSRuntime JS

<MudPaper Class="admin-lesson-video-upload pa-4"
          Elevation="0">

    <!-- ========================================================= -->
    <!-- Header -->
    <!-- ========================================================= -->

    <MudStack Row="true"
              AlignItems="AlignItems.Center"
              Spacing="2"
              Class="mb-4">

        <MudIcon Icon="@Icons.Material.Filled.VideoFile"
                 Color="Color.Primary" />

        <MudText Typo="Typo.h6">

            آپلود ویدئوی درس

        </MudText>

    </MudStack>


    <!-- ========================================================= -->
    <!-- Lesson Info -->
    <!-- ========================================================= -->

    <MudText Typo="Typo.caption"
             Color="Color.Secondary"
             Class="mb-3">

        @Lesson.Title

    </MudText>


    <!-- ========================================================= -->
    <!-- Existing Video -->
    <!-- ========================================================= -->
    @if (_loadingExistingVideo)
    {
        <MudAlert Severity="Severity.Info"
                  Variant="Variant.Outlined"
                  Class="mb-4">

            <MudStack Row="true"
                      AlignItems="AlignItems.Center"
                      Spacing="2">

                <MudProgressCircular Size="Size.Small"
                                     Indeterminate="true" />

                <span>
                    در حال بررسی ویدئوی این درس...
                </span>

            </MudStack>

        </MudAlert>
    }


    @if (!_loadingExistingVideo && _episodes.Count > 0)
    {
        <MudStack Spacing="2" Class="mb-4">
            @foreach (var episode in _episodes.OrderBy(x => x.Order).ToList())
            {
                <MudPaper Class="pa-3" Elevation="1">
                    <MudStack Spacing="2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.subtitle2">@($"{episode.Order}. {episode.Title}")</MudText>
                            <MudChip T="string" Size="Size.Small" Color="@(IsReady(episode) ? Color.Success : IsProcessing(episode) ? Color.Warning : Color.Default)">@episode.Status</MudChip>
                        </MudStack>
                        @if (!string.IsNullOrWhiteSpace(episode.Description))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@episode.Description</MudText>
                        }
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            @if (episode.IsFree)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Info">پیش‌نمایش رایگان</MudChip>
                            }
                            @if (episode.DurationSeconds > 0)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@FormatDuration(episode.DurationSeconds)</MudChip>
                            }
                        </MudStack>
                        @if (IsProcessing(episode))
                        {
                            <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
                        }
                        <MudStack Row="true" Spacing="2" Class="admin-video-actions">
                            @if (IsReady(episode))
                            {
                                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="@(() => ShowPreview(episode))">پخش</MudButton>
                            }
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit" OnClick="@(() => BeginEditEpisode(episode))">ویرایش</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="@(() => DeleteEpisodeAsync(episode))" Disabled="_deletingEpisode">حذف</MudButton>
                        </MudStack>
                        @if (_editingEpisodeId == episode.Id)
                        {
                            <MudDivider />
                            <MudTextField @bind-Value="_editTitle" Label="عنوان ویدیو" Variant="Variant.Outlined" />
                            <MudTextField @bind-Value="_editDescription" Label="توضیحات" Variant="Variant.Outlined" />
                            <MudNumericField T="int" @bind-Value="_editOrder" Label="ترتیب" Min="1" Variant="Variant.Outlined" />
                            <MudCheckBox T="bool" @bind-Value="_editIsFree" Label="پیش‌نمایش رایگان" />
                            <MudStack Row="true" Spacing="2">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveEpisodeEditAsync" Disabled="_savingEpisode">ذخیره تغییرات</MudButton>
                                <MudButton Variant="Variant.Text" OnClick="CancelEpisodeEdit">انصراف</MudButton>
                            </MudStack>
                        }
                    </MudStack>
                </MudPaper>
            }
        </MudStack>
    }
    @if (_previewLesson is not null)
    {
        <MudPaper Class="admin-video-preview pa-3 mb-4"
                  Elevation="1">

            <MudStack Spacing="2">

                <MudStack Row="true"
                          AlignItems="AlignItems.Center"
                          Justify="Justify.SpaceBetween">

                    <MudText Typo="Typo.subtitle2">
                        پیش‌نمایش ویدئو
                    </MudText>

                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                   Color="Color.Default"
                                   Size="Size.Small"
                                   OnClick="HidePreview" />

                </MudStack>

                <VideoPlayer Lesson="_previewLesson"
                             ApiBaseUrl="@ApiBaseUrl" />

            </MudStack>

        </MudPaper>
    }


    <!-- ========================================================= -->
    <!-- Upload Form -->
    <!-- ========================================================= -->

    <MudStack Spacing="3">

        <!-- Order -->

        <MudTextField @bind-Value="_episodeTitle"
                      Label="عنوان این ویدیو"
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      Disabled="_uploading" />

        <MudTextField @bind-Value="_episodeDescription"
                      Label="توضیحات ویدیو"
                      Variant="Variant.Outlined"
                      Lines="2"
                      FullWidth="true"
                      Disabled="_uploading" />

        <MudNumericField T="int"
                         @bind-Value="_order"
                         Label="ترتیب"
                         Variant="Variant.Outlined"
                         Min="1"
                         FullWidth="true"
                         Disabled="_uploading" />


        <!-- Free Preview -->

        <MudCheckBox T="bool"
                     @bind-Value="_isFree"
                     Label="پیش‌نمایش رایگان"
                     Color="Color.Primary"
                     Disabled="_uploading" />


        <!-- File -->

        <div>

            <MudText Typo="Typo.body2"
                     Class="mb-2">

                فایل ویدئو

            </MudText>

            <InputFile OnChange="OnFileSelected"
                       accept="video/*"
                       class="mobile-file-input"
                       disabled="@_uploading" />

        </div>


        <!-- Selected File -->
        @if (_selectedFile is not null)
        {
            <MudPaper Class="pa-3"
                      Elevation="0">

                <MudStack Row="true"
                          AlignItems="AlignItems.Center"
                          Justify="Justify.SpaceBetween">

                    <MudStack Row="true"
                              AlignItems="AlignItems.Center"
                              Spacing="2">

                        <MudIcon Icon="@Icons.Material.Filled.Movie"
                                 Color="Color.Primary" />

                        <div>

                            <MudText Typo="Typo.body2">

                                @_selectedFile.Name

                            </MudText>

                            <MudText Typo="Typo.caption"
                                     Color="Color.Secondary">

                                @FormatFileSize(
                                    _selectedFile.Size)

                            </MudText>

                        </div>

                    </MudStack>


                    @if (!_uploading)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="ClearFile" />
                    }

                </MudStack>

            </MudPaper>
        }


        <!-- Error -->
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error"
                      Variant="Variant.Outlined">

                @_error

            </MudAlert>
        }


        <!-- Upload Progress -->
        @if (_uploading)
        {
            <MudAlert Severity="Severity.Info"
                      Variant="Variant.Outlined">

                <MudStack Spacing="2">

                    <MudStack Row="true"
                              AlignItems="AlignItems.Center"
                              Spacing="2">

                        <MudProgressCircular Size="Size.Small"
                                             Indeterminate="true" />

                        <span>
                            در حال آپلود ویدئو...
                        </span>

                    </MudStack>

                    <MudText Typo="Typo.caption">

                        پس از پایان آپلود، پردازش ویدئو روی سرور انجام می‌شود.

                    </MudText>

                </MudStack>

            </MudAlert>
        }


        <!-- Upload Button -->

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   StartIcon="@Icons.Material.Filled.CloudUpload"
                   OnClick="UploadVideo"
                   Disabled="@(!CanUpload)">

            @if (_uploading)
            {
                <MudProgressCircular Size="Size.Small"
                                     Indeterminate="true" />
            }

            @if (!_uploading)
            {
                <span>
                    آپلود ویدئو
                </span>
            }

        </MudButton>

    </MudStack>

</MudPaper>


@code {

    // =========================================================
    // Parameters
    // =========================================================

    [Parameter]
    public CourseLessonDto Lesson { get; set; } = default!;


    [Parameter]
    public EventCallback<CourseEpisodeDto> OnUploaded { get; set; }


    // =========================================================
    // State
    // =========================================================

    private readonly List<CourseEpisodeDto> _episodes = [];

    private CourseEpisodeDto? _latestEpisode;

    private IBrowserFile? _selectedFile;

    private bool _loadingExistingVideo;

    private bool _uploading;

    private int _order = 1;
    private string _episodeTitle = string.Empty;
    private string _episodeDescription = string.Empty;

    private bool _isFree;

    private string? _error;

    private CancellationTokenSource? _pollCancellation;

    private CourseLessonDto? _previewLesson;

    private bool _deletingEpisode;
    private Guid? _editingEpisodeId;
    private string _editTitle = string.Empty;
    private string _editDescription = string.Empty;
    private int _editOrder = 1;
    private bool _editIsFree;
    private bool _savingEpisode;

    private string ApiBaseUrl =>
        Configuration["Media:PublicBaseUrl"]
        ?? Configuration["Api:BaseUrl"]
        ?? string.Empty;


    // =========================================================
    // Computed
    // =========================================================

    private bool CanUpload
    {
        get
        {
            if (_uploading)
                return false;

            if (_selectedFile is null)
                return false;
            if (string.IsNullOrWhiteSpace(_episodeTitle))
                return false;
            if (_order < 1)
                return false;

            return true;
        }
    }

    private void ShowPreview(CourseEpisodeDto episode)
    {
        if (!IsReady(episode))
            return;

        _previewLesson = new CourseLessonDto
        {
            Id = Lesson.Id,
            Title = Lesson.Title,
            Description = Lesson.Description,
            DurationSeconds = episode.DurationSeconds,
            IsFreePreview = episode.IsFree,
            OrderIndex = Lesson.OrderIndex,
            EpisodeId = episode.Id,
            VideoStatus = episode.Status.ToString(),
            HasVideo = true
        };
    }

    private void HidePreview()
    {
        _previewLesson = null;
    }

    private void BeginEditEpisode(CourseEpisodeDto episode)
    {
        _editingEpisodeId = episode.Id;
        _editTitle = episode.Title;
        _editDescription = episode.Description;
        _editOrder = episode.Order;
        _editIsFree = episode.IsFree;
    }

    private void CancelEpisodeEdit() => _editingEpisodeId = null;

    private async Task SaveEpisodeEditAsync()
    {
        if (_editingEpisodeId is not Guid episodeId || _savingEpisode)
            return;

        _savingEpisode = true;
        try
        {
            var updated = await EpisodeService.UpdateAsync(Lesson.Id, episodeId,
                new CourseEpisodeUpdateRequest
                {
                    Title = _editTitle,
                    Description = _editDescription,
                    Order = _editOrder,
                    IsFree = _editIsFree
                });
            var index = _episodes.FindIndex(x => x.Id == updated.Id);
            if (index >= 0)
                _episodes[index] = updated;
            _latestEpisode = _episodes.OrderByDescending(x => x.Order).FirstOrDefault();
            _editingEpisodeId = null;
            Snackbar.Add("تغییرات ویدیو ذخیره شد.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _savingEpisode = false;
        }
    }

    private async Task DeleteEpisodeAsync(CourseEpisodeDto episode)
    {
        if (_deletingEpisode)
            return;

        var confirmed = await JS.InvokeAsync<bool>("confirm", $"آیا ویدیوی «{episode.Title}» حذف شود؟");
        if (!confirmed)
            return;

        _deletingEpisode = true;
        try
        {
            await EpisodeService.DeleteAsync(Lesson.Id, episode.Id);
            if (_previewLesson?.EpisodeId == episode.Id)
                HidePreview();
            await LoadExistingVideos();
            Snackbar.Add("ویدیو حذف شد.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _deletingEpisode = false;
        }
    }
    // =========================================================
    // Initialize
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadExistingVideos();
    }


    // =========================================================
    // Load Existing Videos
    // =========================================================

    private async Task LoadExistingVideos()
    {
        _loadingExistingVideo = true;

        _error = null;

        try
        {
            var result =
                await EpisodeService.GetByLessonIdAsync(
                    Lesson.Id);

            _episodes.Clear();

            _episodes.AddRange(
                result.OrderBy(x => x.Order));

            _latestEpisode =
                _episodes
                    .OrderByDescending(x => x.Order)
                    .FirstOrDefault();


            if (_latestEpisode is not null)
            {
                Lesson.HasVideo = true;

                _order =
                    Math.Max(1, _episodes.Max(x => x.Order) + 1);
            }


            _episodeTitle = $"{Lesson.Title} - ویدیو {_order}";
            if (_latestEpisode is not null && IsProcessing(_latestEpisode))
                StartPolling(_latestEpisode.Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[LESSON VIDEO] Load existing videos failed: {ex}");

            _error =
                ex.Message;
        }
        finally
        {
            _loadingExistingVideo = false;
        }
    }


    // =========================================================
    // File Selected
    // =========================================================

    private void OnFileSelected(
        InputFileChangeEventArgs e)
    {
        _error = null;

        try
        {
            _selectedFile =
                e.File;

            if (_selectedFile is null)
                return;

            Console.WriteLine(
                $"[LESSON VIDEO] File selected: {_selectedFile.Name}");

            Console.WriteLine(
                $"[LESSON VIDEO] File size: {_selectedFile.Size}");

            Console.WriteLine(
                $"[LESSON VIDEO] Content type: {_selectedFile.ContentType}");
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[LESSON VIDEO] File selection failed: {ex}");

            _selectedFile = null;

            _error =
                "انتخاب فایل ویدئو ناموفق بود.";
        }
    }


    // =========================================================
    // Clear File
    // =========================================================

    private void ClearFile()
    {
        if (_uploading)
            return;

        _selectedFile = null;

        _error = null;
    }


    // =========================================================
    // Upload
    // =========================================================

    private async Task UploadVideo()
    {
        if (!CanUpload)
            return;

        _uploading = true;

        _error = null;

        try
        {
            var file =
                _selectedFile!;

            Console.WriteLine(
                "[LESSON VIDEO] Starting upload...");

            Console.WriteLine(
                $"[LESSON VIDEO] LessonId: {Lesson.Id}");

            Console.WriteLine(
                $"[LESSON VIDEO] File: {file.Name}");

            Console.WriteLine(
                $"[LESSON VIDEO] Size: {file.Size}");

            await using var stream =
                file.OpenReadStream(
                    maxAllowedSize: 3_000_000_000L);

            var episode =
                await EpisodeService.UploadAsync(
                    Lesson.Id,
                    _episodeTitle.Trim(),
                    _episodeDescription.Trim(),
                    _order,
                    _isFree,
                    stream,
                    file.Name,
                    file.ContentType);


            Console.WriteLine(
                $"[LESSON VIDEO] Upload response Id: {episode.Id}");

            Console.WriteLine(
                $"[LESSON VIDEO] Upload response Status: {episode.Status}");


            // =================================================
            // Update lesson immediately
            // =================================================

            Lesson.HasVideo = true;


            // =================================================
            // Update local episode list
            // =================================================

            _episodes.RemoveAll(
                x => x.Id == episode.Id);

            _episodes.Add(
                episode);

            _latestEpisode =
                _episodes
                    .OrderByDescending(x => x.Order)
                    .FirstOrDefault();

            _order = Math.Max(1, _episodes.Max(x => x.Order) + 1);
            _episodeTitle = $"{Lesson.Title} - ویدیو {_order}";
            _episodeDescription = string.Empty;


            _selectedFile = null;


            Snackbar.Add(
                "ویدئو با موفقیت آپلود شد و پردازش آن آغاز شد.",
                Severity.Success);


            // =================================================
            // Notify parent
            // =================================================

            await OnUploaded.InvokeAsync(
                episode);


            // =================================================
            // Poll processing status
            // =================================================

            if (IsProcessing(episode))
            {
                StartPolling(
                    episode.Id);
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[LESSON VIDEO] Upload failed: {ex}");

            _error =
                ex.Message;

            Snackbar.Add(
                ex.Message,
                Severity.Error);
        }
        finally
        {
            _uploading = false;
        }
    }


    // =========================================================
    // Polling
    // =========================================================

    private void StartPolling(
        Guid episodeId)
    {
        _pollCancellation?.Cancel();

        _pollCancellation?.Dispose();

        _pollCancellation =
            new CancellationTokenSource();

        var token =
            _pollCancellation.Token;

        _ = PollStatusAsync(
            episodeId,
            token);
    }


    private async Task PollStatusAsync(
        Guid episodeId,
        CancellationToken cancellationToken)
    {
        try
        {
            for (var i = 0; i < 120; i++)
            {
                if (cancellationToken.IsCancellationRequested)
                    return;

                await Task.Delay(
                    TimeSpan.FromSeconds(3),
                    cancellationToken);


                CourseEpisodeDto status;

                try
                {
                    status =
                        await EpisodeService.GetStatusAsync(
                            Lesson.Id,
                            episodeId);
                }
                catch (Exception ex)
                {
                    Console.WriteLine(
                        $"[LESSON VIDEO] Status check failed: {ex}");

                    continue;
                }


                _latestEpisode =
                    status;


                var existing =
                    _episodes.FindIndex(
                        x => x.Id == status.Id);

                if (existing >= 0)
                {
                    _episodes[existing] =
                        status;
                }
                else
                {
                    _episodes.Add(
                        status);
                }


                if (IsReady(status))
                {
                    Lesson.HasVideo = true;

                    await InvokeAsync(
                        StateHasChanged);

                    Snackbar.Add(
                        "ویدئو با موفقیت پردازش شد و آماده پخش است.",
                        Severity.Success);

                    return;
                }


                if (IsFailed(status))
                {
                    await InvokeAsync(
                        StateHasChanged);

                    Snackbar.Add(
                        "پردازش ویدئو با خطا مواجه شد.",
                        Severity.Error);

                    return;
                }


                await InvokeAsync(
                    StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // طبیعی است.
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[LESSON VIDEO] Polling failed: {ex}");
        }
    }


    // =========================================================
    // Status Helpers
    // =========================================================

    private static bool IsReady(
       CourseEpisodeDto? episode)
    {
        if (episode is null)
            return false;

        var status =
            episode.Status.ToString();

        return
            string.Equals(
                status,
                "Ready",
                StringComparison.OrdinalIgnoreCase)
            ||
            string.Equals(
                status,
                "Completed",
                StringComparison.OrdinalIgnoreCase);
    }


    private static bool IsProcessing(
        CourseEpisodeDto? episode)
    {
        if (episode is null)
            return false;

        var status =
            episode.Status.ToString();

        return
            string.Equals(
                status,
                "Processing",
                StringComparison.OrdinalIgnoreCase)
            ||
            string.Equals(
                status,
                "Pending",
                StringComparison.OrdinalIgnoreCase)
            ||
            string.Equals(
                status,
                "Queued",
                StringComparison.OrdinalIgnoreCase);
    }


    private static bool IsFailed(
        CourseEpisodeDto? episode)
    {
        if (episode is null)
            return false;

        var status =
            episode.Status.ToString();

        return
            string.Equals(
                status,
                "Failed",
                StringComparison.OrdinalIgnoreCase)
            ||
            string.Equals(
                status,
                "Error",
                StringComparison.OrdinalIgnoreCase);
    }


    // =========================================================
    // Formatting
    // =========================================================

    private static string FormatFileSize(
        long bytes)
    {
        if (bytes < 1024)
            return $"{bytes} B";

        if (bytes < 1024 * 1024)
            return $"{bytes / 1024d:0.##} KB";

        if (bytes < 1024L * 1024L * 1024L)
            return $"{bytes / 1024d / 1024d:0.##} MB";

        return
            $"{bytes / 1024d / 1024d / 1024d:0.##} GB";
    }


    private static string FormatDuration(
        int seconds)
    {
        if (seconds <= 0)
            return "مدت نامشخص";

        var time =
            TimeSpan.FromSeconds(
                seconds);

        if (time.TotalHours >= 1)
        {
            return
                $"{(int)time.TotalHours:00}:{time.Minutes:00}:{time.Seconds:00}";
        }

        return
            $"{time.Minutes:00}:{time.Seconds:00}";
    }


    // =========================================================
    // Dispose
    // =========================================================

    public void Dispose()
    {
        _pollCancellation?.Cancel();

        _pollCancellation?.Dispose();
    }

}
