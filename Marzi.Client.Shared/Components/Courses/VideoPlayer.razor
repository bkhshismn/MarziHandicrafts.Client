@using Marzi.Client.Core.Authentication
@using Marzi.Client.Core.Models.Courses
@using Microsoft.JSInterop

@implements IAsyncDisposable

@inject ITokenStorage TokenStorage
@inject IJSRuntime JS

@if (Lesson is null)
{
    <MudPaper Class="video-player-empty"
              Elevation="0">

        <MudIcon Icon="@Icons.Material.Filled.VideoLibrary"
                 Size="Size.Large"
                 Color="Color.Secondary" />

        <MudText Typo="Typo.body1"
                 Color="Color.Secondary">

            درسی برای پخش انتخاب نشده است.

        </MudText>

    </MudPaper>
}
else if (!Lesson.HasVideo)
{
    <MudAlert Severity="Severity.Info">

        برای این درس هنوز ویدئویی قرار نگرفته است.

    </MudAlert>
}
else
{
    <div class="video-player-wrapper">

        <video @ref="_videoElement"
               class="video-player"
               controls
               playsinline
               preload="metadata">
        </video>

        @if (_loading)
        {
            <div class="video-player-loading">

                <MudProgressCircular Indeterminate="true"
                                     Color="Color.Primary" />

                <MudText Typo="Typo.body2">
                    در حال آماده‌سازی ویدئو...
                </MudText>

            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="video-player-error">

                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline"
                         Size="Size.Large"
                         Color="Color.Error" />

                <MudText Typo="Typo.body2">
                    @_error
                </MudText>

            </div>
        }

    </div>
}

@code {

    [Parameter]
    public required CourseLessonDto Lesson { get; set; }

    [Parameter]
    public required string ApiBaseUrl { get; set; }

    private ElementReference _videoElement;

    private IJSObjectReference? _module;

    private bool _loading;

    private bool _initializing;

    private string? _error;

    private Guid? _initializedEpisodeId;

    private Guid? _currentEpisodeId;


    // ============================================================
    // Parameters changed
    // ============================================================

    protected override void OnParametersSet()
    {
        var episodeId = Lesson?.EpisodeId;

        if (_currentEpisodeId != episodeId)
        {
            _currentEpisodeId = episodeId;

            _initializedEpisodeId = null;

            _error = null;

            _loading = false;

            _initializing = false;
        }
    }


    // ============================================================
    // After render
    // ============================================================

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (Lesson is null ||
            !Lesson.HasVideo ||
            Lesson.EpisodeId is null)
        {
            return;
        }

        if (!string.Equals(
                Lesson.VideoStatus,
                "Ready",
                StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        if (_initializedEpisodeId == Lesson.EpisodeId)
        {
            return;
        }

        if (_initializing)
        {
            return;
        }

        await InitializePlayerAsync();
    }


    // ============================================================
    // Initialize
    // ============================================================

    private async Task InitializePlayerAsync()
    {
        if (Lesson is null ||
            !Lesson.HasVideo ||
            Lesson.EpisodeId is null)
        {
            return;
        }

        if (_initializing)
        {
            return;
        }

        _initializing = true;

        try
        {
            _loading = true;
            _error = null;

            await InvokeAsync(StateHasChanged);


            // ====================================================
            // Playlist URL
            // ====================================================

            var playlistUrl =
                $"{ApiBaseUrl.TrimEnd('/')}" +
                $"/api/admin/lessons/{Lesson.Id}/video/" +
                $"{Lesson.EpisodeId}/stream/master.m3u8";


            Console.WriteLine(
                "[VIDEO PLAYER] =============================");

            Console.WriteLine(
                $"[VIDEO PLAYER] LessonId: {Lesson.Id}");

            Console.WriteLine(
                $"[VIDEO PLAYER] EpisodeId: {Lesson.EpisodeId}");

            Console.WriteLine(
                $"[VIDEO PLAYER] VideoStatus: {Lesson.VideoStatus}");

            Console.WriteLine(
                $"[VIDEO PLAYER] IsFreePreview: {Lesson.IsFreePreview}");

            Console.WriteLine(
                $"[VIDEO PLAYER] Playlist: {playlistUrl}");


            // ====================================================
            // Token
            //
            // FREE VIDEO:
            //     token = null
            //
            // PAID VIDEO:
            //     token required
            // ====================================================

            string? token = null;

            if (Lesson.IsFreePreview)
            {
                Console.WriteLine(
                    "[VIDEO PLAYER] FREE PREVIEW");

                Console.WriteLine(
                    "[VIDEO PLAYER] No access token required.");
            }
            else
            {
                // ------------------------------------------------
                // Paid video
                // ------------------------------------------------

                token =
                    await GetAccessTokenAsync();

                if (string.IsNullOrWhiteSpace(token))
                {
                    _error =
                        "برای مشاهده این ویدئو باید وارد حساب کاربری شوید.";

                    Console.WriteLine(
                        "[VIDEO PLAYER] Paid video but token is unavailable.");

                    return;
                }

                Console.WriteLine(
                    "[VIDEO PLAYER] Paid video. Token exists.");
            }


            // ====================================================
            // Load HLS JS module
            // ====================================================

            _module ??=
                await JS.InvokeAsync<IJSObjectReference>(
                    "import",
                    "./_content/Marzi.Client.Shared/js/hlsPlayer.js");


            // ====================================================
            // Initialize HLS
            // ====================================================

            await _module.InvokeVoidAsync(
                "initialize",
                _videoElement,
                playlistUrl,
                token);


            // ====================================================
            // Mark initialized ONLY after success
            // ====================================================

            _initializedEpisodeId =
                Lesson.EpisodeId;

            Console.WriteLine(
                $"[VIDEO PLAYER] Initialized successfully. " +
                $"EpisodeId={Lesson.EpisodeId}");

            Console.WriteLine(
                "[VIDEO PLAYER] =============================");
        }
        catch (JSException ex)
        {
            _error =
                "پخش‌کننده ویدئو بارگذاری نشد.";

            Console.WriteLine(
                $"[VIDEO PLAYER] JS ERROR: {ex}");
        }
        catch (Exception ex)
        {
            _error =
                "خطایی هنگام آماده‌سازی ویدئو رخ داد.";

            Console.WriteLine(
                $"[VIDEO PLAYER] ERROR: {ex}");
        }
        finally
        {
            _loading = false;

            _initializing = false;

            await InvokeAsync(StateHasChanged);
        }
    }


    // ============================================================
    // Get token for paid videos
    // ============================================================

    private async Task<string?> GetAccessTokenAsync()
    {
        const int maxAttempts = 20;

        const int delayMilliseconds = 250;

        for (var attempt = 1;
             attempt <= maxAttempts;
             attempt++)
        {
            var token =
                await GetTokenFromStorageAsync();

            if (!string.IsNullOrWhiteSpace(token))
            {
                Console.WriteLine(
                    $"[VIDEO PLAYER] Access token ready. " +
                    $"Attempt={attempt}");

                return token;
            }

            Console.WriteLine(
                $"[VIDEO PLAYER] Access token not ready. " +
                $"Attempt={attempt}/{maxAttempts}");

            if (attempt < maxAttempts)
            {
                await Task.Delay(
                    delayMilliseconds);
            }
        }

        return null;
    }


    // ============================================================
    // Token Storage
    // ============================================================

    private async Task<string?> GetTokenFromStorageAsync()
    {
        // TokenStorage را فقط برای ویدئوهای پولی استفاده می‌کنیم.
        //
        // اینجا عمداً مستقیم از سرویس استفاده می‌شود.
        //
        // چون این کامپوننت قبلاً ITokenStorage را inject می‌کرد،
        // اگر سرویس شما نام متفاوتی دارد، همان سرویس فعلی را نگه دار.

        return await TokenStorage.GetAccessTokenAsync();
    }


    // ============================================================
    // Dispose
    // ============================================================

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync(
                    "dispose",
                    _videoElement);

                await _module.DisposeAsync();

                _module = null;
            }
        }
        catch
        {
            // Component may already be disposed.
        }
    }
}