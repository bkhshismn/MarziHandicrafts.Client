@using MudBlazor

@{
    const string phone = "+989119009567";
    const string address =
        "مازندران، جویبار، زرین‌کلا، خیابان ورزش، کوچه پونه، آموزشگاه آسمان";
}

<footer class="site-footer">

    <MudContainer MaxWidth="MaxWidth.Large" Class="py-8">

        <MudGrid Spacing="4">

            <!-- Brand -->
            <MudItem xs="12" md="4">
                <MudText Typo="Typo.h5" Class="footer-brand">مرزی</MudText>

                <MudText Typo="Typo.body2" Class="footer-text mt-2">
                    هنر دست، از دل مازندران. پاپیه‌ماشه، سردیس و پرتره،
                    ماسک و مجسمه‌های دکوراتیو — ساخته‌شده با صبر و جزئیات.
                </MudText>

                <div class="footer-social">

                    <a href="https://www.instagram.com/marzi.handicrafts/"
                       target="_blank"
                       rel="noopener"
                       class="social-button"
                       aria-label="اینستاگرام"
                       title="اینستاگرام">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                            <path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16Zm0 1.8c-3.14 0-3.5.01-4.74.07-1.15.05-1.77.24-2.18.4-.55.21-.94.47-1.35.88-.41.41-.67.8-.88 1.35-.16.41-.35 1.03-.4 2.18-.06 1.24-.07 1.6-.07 4.74s.01 3.5.07 4.74c.05 1.15.24 1.77.4 2.18.21.55.47.94.88 1.35.41.41.8.67 1.35.88.41.16 1.03.35 2.18.4 1.24.06 1.6.07 4.74.07s3.5-.01 4.74-.07c1.15-.05 1.77-.24 2.18-.4.55-.21.94-.47 1.35-.88.41-.41.67-.8.88-1.35.16-.41.35-1.03.4-2.18.06-1.24.07-1.6.07-4.74s-.01-3.5-.07-4.74c-.05-1.15-.24-1.77-.4-2.18a3.6 3.6 0 0 0-.88-1.35 3.6 3.6 0 0 0-1.35-.88c-.41-.16-1.03-.35-2.18-.4-1.24-.06-1.6-.07-4.74-.07Zm0 3.06a4.98 4.98 0 1 1 0 9.96 4.98 4.98 0 0 1 0-9.96Zm0 8.21a3.23 3.23 0 1 0 0-6.46 3.23 3.23 0 0 0 0 6.46Zm6.34-8.4a1.16 1.16 0 1 1-2.32 0 1.16 1.16 0 0 1 2.32 0Z" />
                        </svg>
                    </a>

                    <a href="@($"https://wa.me/{phone.TrimStart('+')}")"
                       target="_blank"
                       rel="noopener"
                       class="social-button"
                       aria-label="واتس‌اپ"
                       title="واتس‌اپ">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                            <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.95 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.88 1.21 3.08c.15.2 2.09 3.2 5.07 4.49.71.31 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.05 2C6.55 2 2.1 6.45 2.1 11.95c0 1.76.46 3.45 1.32 4.93L2 22l5.25-1.38a9.9 9.9 0 0 0 4.8 1.22h.01c5.5 0 9.95-4.45 9.95-9.95S17.55 2 12.05 2Z" />
                        </svg>
                    </a>

                    <a href="@($"https://t.me/{phone}")"
                       target="_blank"
                       rel="noopener"
                       class="social-button"
                       aria-label="تلگرام"
                       title="تلگرام">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                            <path d="M21.94 4.6 18.9 19.2c-.23 1.02-.84 1.27-1.7.79l-4.7-3.47-2.27 2.19c-.25.25-.46.46-.94.46l.34-4.79 8.72-7.88c.38-.34-.08-.53-.59-.19L6.98 13.1 2.3 11.64c-1.02-.32-1.04-1.02.21-1.51l18.32-7.06c.85-.31 1.59.2 1.11 1.53Z" />
                        </svg>
                    </a>

                    <a href="@($"tel:{phone}")"
                       class="social-button"
                       aria-label="تماس تلفنی"
                       title="تماس تلفنی">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                            <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.5.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C11.6 21 3 12.4 3 2c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.5.1.4 0 .8-.2 1L6.6 10.8Z" />
                        </svg>
                    </a>

                </div>
            </MudItem>

            <!-- Quick links -->
            <MudItem xs="6" md="2">
                <MudText Typo="Typo.subtitle1" Class="footer-heading">دسترسی سریع</MudText>

                <div class="footer-links">
                    <a href="/">خانه</a>
                    <a href="/courses">دوره‌های آموزشی</a>
                    <a href="/portfolio">نمونه‌کارها</a>
                    <a href="/orders">سفارش ساخت</a>
                </div>
            </MudItem>

            <!-- About links -->
            <MudItem xs="6" md="3">
                <MudText Typo="Typo.subtitle1" Class="footer-heading">دربارهٔ مرزی</MudText>

                <div class="footer-links">
                    <a href="/about">داستان کارگاه</a>
                    <a href="/contact">تماس و گفتگو با مدیر</a>
                    <a href="https://www.instagram.com/marzi.handicrafts/" target="_blank" rel="noopener">
                        صفحهٔ اینستاگرام
                    </a>
                </div>
            </MudItem>

            <!-- Contact -->
            <MudItem xs="12" md="3">
                <MudText Typo="Typo.subtitle1" Class="footer-heading">تماس با ما</MudText>

                <MudText Typo="Typo.body2" Class="footer-text">
                    @address
                </MudText>

                <a class="footer-location mt-2"
                   href="@($"https://maps.google.com/?q={Uri.EscapeDataString(address)}")"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="موقعیت کارگاه مرزی روی نقشه">
                    <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" />
                    مشاهدهٔ موقعیت روی نقشه
                </a>

                <MudText Typo="Typo.body2" Class="footer-text mt-2">
                    <a href="@($"tel:{phone}")" dir="ltr">+98 911 900 9567</a>
                </MudText>

                <MudButton Href="/contact"
                           Variant="Variant.Outlined"
                           Color="Color.Inherit"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Chat"
                           Class="footer-cta mt-3">
                    گفتگو با مدیر
                </MudButton>
            </MudItem>

        </MudGrid>

        <MudDivider Class="footer-divider my-6" />

        <div class="footer-bottom">
            <span>© @PersianDateFormatter.FormatYear(DateTime.Now) مرزی — تمام حقوق محفوظ است.</span>
            <span>دست‌ساز در جویبار، مازندران</span>
        </div>

    </MudContainer>

</footer>
