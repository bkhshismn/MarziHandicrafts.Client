@using Marzi.Client.Core.Models.Portfolio
@using MudBlazor
@inject NavigationManager Navigation

@if (Item is null)
{
    <MudAlert Severity="Severity.Warning">
        اطلاعات نمونه‌کار موجود نیست.
    </MudAlert>
    return;
}

<MudCard Class="portfolio-card"
         Elevation="2"
         Style="cursor:pointer"
         @onclick="Open">

    <MudCardMedia Height="220"
                  Image="@CoverImage" />

    <MudCardContent>

        <MudStack Spacing="2">

            <MudChip T="string"
                     Color="Color.Primary"
                     Variant="Variant.Filled"
                     Size="Size.Small">

                @(string.IsNullOrWhiteSpace(Item.Category)
                    ? "عمومی"
                    : Item.Category)

            </MudChip>

            <MudText Typo="Typo.h6"
                     Class="card-title">

                @Item.Title

            </MudText>

            <MudText Typo="Typo.body2"
                     Color="Color.Secondary"
                     Class="description">

                @(Item.Description.Length > 90
                    ? Item.Description[..90] + "..."
                    : Item.Description)

            </MudText>

            <MudDivider />

            <MudStack Row="true"
                      Justify="Justify.SpaceBetween"
                      AlignItems="AlignItems.Center">

                <MudText Typo="Typo.caption"
                         Color="Color.Secondary">

                    @Item.CreatedAt.ToString("yyyy/MM/dd")

                </MudText>

                @if (Item.Images.Any())
                {
                    <MudChip T="string"
                             Size="Size.Small"
                             Color="Color.Info"
                             Variant="Variant.Outlined">

                        @($"{Item.Images.Count} تصویر")

                    </MudChip>
                }

            </MudStack>

        </MudStack>

    </MudCardContent>

</MudCard>

@code {

    [Parameter]
    public PortfolioItemDto? Item { get; set; }

    private string CoverImage
    {
        get
        {
            if (Item is null)
                return "/images/course-placeholder.jpg";

            var image = Item.Images
                .OrderBy(x => x.Order)
                .FirstOrDefault();

            if (image is null)
                return "/images/course-placeholder.jpg";

            if (string.IsNullOrWhiteSpace(image.ImageUrl))
                return "/images/course-placeholder.jpg";

            return image.ImageUrl;
        }
    }

    private void Open()
    {
        if (Item is null)
            return;

        Navigation.NavigateTo($"/portfolio/{Item.Id}");
    }

}