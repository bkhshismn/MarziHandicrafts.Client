@inherits LayoutComponentBase
@implements IDisposable

@using MudBlazor
@using Microsoft.AspNetCore.Components.Authorization
@using Marzi.Client.Shared.Components.Navigation
@using Marzi.Client.Shared.Theme
@using Marzi.Client.Shared.Services
@using Marzi.Client.Shared.Components.Common
@using Marzi.Client.Infrastructure.Services
@using Marzi.Client.Infrastructure.Api
@using Microsoft.JSInterop

@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IAnalyticsApi AnalyticsApi

<MudRTLProvider RightToLeft="@(!_english)">

    <MudThemeProvider Theme="@ThemePreference.CurrentTheme" />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    <MudLayout>

        <MudAppBar Elevation="1"
                   Color="Color.Primary"
                   Class="marzi-appbar">

            <MudText Typo="Typo.h6"
                     Class="brand-title">
                Marzi Handicrafts
            </MudText>

            <MudSpacer />

            <ThemePicker />
            <AuthorizeView>
                <Authorized><UserOrderNotificationCenter /></Authorized>
            </AuthorizeView>
            @* Language switch is temporarily hidden while the English UI is being completed. *@

            <div class="desktop-navigation">

                <MudButton Href="/"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.Home">
                    خانه
                </MudButton>

                <MudButton Href="/courses"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.School">
                    دوره‌ها
                </MudButton>

                <MudButton Href="/shop"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.Storefront">
                    فروشگاه
                </MudButton>

                <MudButton Href="/portfolio"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.Palette">
                    نمونه‌کارها
                </MudButton>

                <MudButton Href="/orders"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.ShoppingBag">
                    سفارش
                </MudButton>

                <MudButton Href="/shop/cart"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.ShoppingCart">
                    سبد خرید (@CartItemCount)
                </MudButton>

                <AuthorizeView Roles="Admin">
                    <Authorized>
                        <MudButton Href="/admin"
                                   Color="Color.Inherit"
                                   StartIcon="@Icons.Material.Filled.AdminPanelSettings">
                            مدیریت
                        </MudButton>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView>
                    <Authorized>
                        <MudButton Href="/profile"
                                   Color="Color.Inherit"
                                   StartIcon="@Icons.Material.Filled.Person">
                            پروفایل
                        </MudButton>

                        <MudButton Color="Color.Inherit"
                                   StartIcon="@Icons.Material.Filled.Logout"
                                   OnClick="LogoutAsync">
                            خروج
                        </MudButton>
                    </Authorized>
                    <NotAuthorized>
                        <MudButton Href="/login"
                                   Color="Color.Inherit"
                                   StartIcon="@Icons.Material.Filled.Login">
                            ورود
                        </MudButton>
                        <MudButton Href="/register"
                                   Color="Color.Inherit"
                                   StartIcon="@Icons.Material.Filled.PersonAdd">
                            ثبت‌نام
                        </MudButton>
                    </NotAuthorized>
                </AuthorizeView>

            </div>

            <div class="mobile-auth-action">
                <AuthorizeView>
                    <Authorized>
                        <MudIconButton Icon="@Icons.Material.Filled.Logout"
                                       Color="Color.Inherit"
                                       title="خروج"
                                       OnClick="LogoutAsync" />
                    </Authorized>
                    <NotAuthorized>
                        <MudIconButton Href="/login"
                                       Icon="@Icons.Material.Filled.Login"
                                       Color="Color.Inherit"
                                       title="ورود" />
                    </NotAuthorized>
                </AuthorizeView>
            </div>

            <AuthorizeView>
                <NotAuthorized>
                    <MudIconButton Href="/register"
                                   Icon="@Icons.Material.Filled.PersonAdd"
                                   Color="Color.Inherit"
                                   title="ثبت‌نام" />
                </NotAuthorized>
            </AuthorizeView>
            <MudIconButton Href="/shop/cart"
                           Icon="@Icons.Material.Filled.ShoppingCart"
                           Color="Color.Inherit"
                           title="سبد خرید" />

        </MudAppBar>


        <MudMainContent>

            <div class="main-content">
                <div class="main-content-inner">
                    @Body
                </div>
            </div>

        </MudMainContent>


        <SiteFooter />


        <div class="mobile-bottom-navigation">

            <BottomNavigation />

        </div>

    </MudLayout>

</MudRTLProvider>

@code {
    [Inject] private ThemePreferenceService ThemePreference { get; set; } = default!;
    [Inject] private ShopCartService ShopCart { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    private bool _english;
    private int CartItemCount => ShopCart.ItemCount;

    protected override void OnInitialized()
    {
        ThemePreference.Changed += OnThemeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _english = await JS.InvokeAsync<string>("localStorage.getItem", "marzi-language") == "en";
            await JS.InvokeVoidAsync("marziLanguage.set", _english ? "en" : "fa");
            StateHasChanged();
            await ThemePreference.InitializeAsync();
            ShopCart.Changed += OnCartChanged;
            await ShopCart.LoadAsync();

            Navigation.LocationChanged += OnLocationChanged;

            await TrackPageViewAsync();
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        _ = TrackPageViewAsync();

    private async Task TrackPageViewAsync()
    {
        try
        {
            var path = new Uri(Navigation.Uri).AbsolutePath;

            // صفحات مدیریتی در آمار عمومی شمرده نمی‌شوند.
            if (path.StartsWith("/admin", StringComparison.OrdinalIgnoreCase))
                return;

            await AnalyticsApi.TrackPageViewAsync(
                new PageViewRequest { Path = path });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ANALYTICS] Page view failed: {ex.Message}");
        }
    }

    private void OnThemeChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnCartChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ThemePreference.Changed -= OnThemeChanged;
        ShopCart.Changed -= OnCartChanged;

        Navigation.LocationChanged -= OnLocationChanged;
    }

    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/", replace: true);
    }
}
