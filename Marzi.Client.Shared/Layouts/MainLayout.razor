@inherits LayoutComponentBase

@using MudBlazor
@using Microsoft.AspNetCore.Components.Authorization
@using Marzi.Client.Shared.Components.Navigation
@using Marzi.Client.Shared.Theme
@using Marzi.Client.Infrastructure.Services

@inject AuthService AuthService
@inject NavigationManager Navigation

<MudRTLProvider RightToLeft="true">

    <MudThemeProvider Theme="@AppTheme.Default" />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    <MudLayout>

        <MudAppBar Elevation="1"
                   Color="Color.Primary"
                   Class="marzi-appbar">

            <MudText Typo="Typo.h6"
                     Class="brand-title">
                Marzi Handicrafts
            </MudText>

            <MudSpacer />

            <div class="desktop-navigation">

                <MudButton Href="/"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.Home">
                    خانه
                </MudButton>

                <MudButton Href="/courses"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.School">
                    دوره‌ها
                </MudButton>

                <MudButton Href="/portfolio"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.Palette">
                    نمونه‌کارها
                </MudButton>

                <MudButton Href="/orders"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.ShoppingBag">
                    سفارش
                </MudButton>

                <AuthorizeView Roles="Admin">
                    <Authorized>
                        <MudButton Href="/admin"
                                   Color="Color.Inherit"
                                   StartIcon="@Icons.Material.Filled.AdminPanelSettings">
                            مدیریت
                        </MudButton>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView>
                    <Authorized>
                        <MudButton Href="/profile"
                                   Color="Color.Inherit"
                                   StartIcon="@Icons.Material.Filled.Person">
                            پروفایل
                        </MudButton>

                        <MudButton Color="Color.Inherit"
                                   StartIcon="@Icons.Material.Filled.Logout"
                                   OnClick="LogoutAsync">
                            خروج
                        </MudButton>
                    </Authorized>
                    <NotAuthorized>
                        <MudButton Href="/login"
                                   Color="Color.Inherit"
                                   StartIcon="@Icons.Material.Filled.Login">
                            ورود
                        </MudButton>
                    </NotAuthorized>
                </AuthorizeView>

            </div>

            <div class="mobile-auth-action">
                <AuthorizeView>
                    <Authorized>
                        <MudIconButton Icon="@Icons.Material.Filled.Logout"
                                       Color="Color.Inherit"
                                       title="خروج"
                                       OnClick="LogoutAsync" />
                    </Authorized>
                    <NotAuthorized>
                        <MudIconButton Href="/login"
                                       Icon="@Icons.Material.Filled.Login"
                                       Color="Color.Inherit"
                                       title="ورود" />
                    </NotAuthorized>
                </AuthorizeView>
            </div>

            <MudIconButton Icon="@Icons.Material.Filled.Notifications"
                           Color="Color.Inherit" />

        </MudAppBar>


        <MudMainContent>

            <div class="main-content">
                <div class="main-content-inner">
                    @Body
                </div>
            </div>

        </MudMainContent>


        <div class="mobile-bottom-navigation">

            <BottomNavigation />

        </div>

    </MudLayout>

</MudRTLProvider>

@code {
    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/", replace: true);
    }
}