@inherits LayoutComponentBase
@implements IDisposable

@using MudBlazor
@using Marzi.Client.Shared.Theme
@using Marzi.Client.Shared.Components.Navigation
@using Marzi.Client.Infrastructure.Services
@using Microsoft.AspNetCore.Components.Authorization

@inject AuthService AuthService
@inject NavigationManager NavigationManager

<MudRTLProvider RightToLeft="true">

    <MudThemeProvider Theme="@ThemePreference.CurrentTheme" />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    <MudLayout>

        <!-- ================================================= -->
        <!-- Desktop AppBar -->
        <!-- ================================================= -->

        <MudAppBar Elevation="1"
                   Color="Color.Primary"
                   Class="marzi-appbar">

            <MudText Typo="Typo.h6"
                     Class="brand-title">

                Marzi Admin

            </MudText>

            <MudSpacer />

            <ThemePicker />

            <AuthorizeView Roles="Admin,Instructor">
                <Authorized Context="staffContext">
                    <div class="desktop-navigation">
                <AuthorizeView Roles="Admin">
                    <Authorized Context="adminContext">
                <MudButton Href="/admin"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.Dashboard">

                    داشبورد

                </MudButton>
                    </Authorized>
                </AuthorizeView>
                <MudButton Href="/admin/courses"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.School">

                    دوره‌ها و ویدئوها

                </MudButton>


                <AuthorizeView Roles="Admin">
                    <Authorized Context="adminContext">
                <MudButton Href="/admin/orders"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.ShoppingCart">

                    سفارش‌ها

                </MudButton>
                    </Authorized>
                </AuthorizeView>


                <MudButton Href="/portfolio"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.Palette">

                    نمونه‌کارها

                </MudButton>

                <MudButton Href="/admin/portfolio/add"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.AddPhotoAlternate">

                    افزودن نمونه‌کار

                </MudButton>


                <MudButton Href="/"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.Home">

                    مشاهده سایت

                </MudButton>

                <MudButton Href="/profile"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.Person">

                    پروفایل

                </MudButton>


                <MudIconButton Icon="@Icons.Material.Filled.Logout"
                               Color="Color.Inherit"
                               OnClick="LogoutAsync" />

                    </div>
                </Authorized>
            </AuthorizeView>

        </MudAppBar>


        <AuthorizeView Roles="Admin,Instructor">
            <Authorized Context="staffContext">
        <aside class="admin-sidebar">
            <div class="admin-sidebar-heading">
                <span class="admin-sidebar-kicker">Marzi Admin</span>
                <strong>مرکز مدیریت</strong>
            </div>

            <nav class="admin-sidebar-nav" aria-label="ناوبری مدیریت">
                <AuthorizeView Roles="Admin">
                    <Authorized Context="adminContext">
                <NavLink href="/admin"
                         Match="NavLinkMatch.All"
                         class="admin-sidebar-link"
                         ActiveClass="admin-sidebar-link-active">
                    <MudIcon Icon="@Icons.Material.Filled.Dashboard" Class="admin-sidebar-icon" />
                    <span>داشبورد</span>
                </NavLink>
                    </Authorized>
                </AuthorizeView>
                <NavLink href="/admin/courses"
                         class="admin-sidebar-link"
                         ActiveClass="admin-sidebar-link-active">
                    <MudIcon Icon="@Icons.Material.Filled.School" Class="admin-sidebar-icon" />
                    <span>دوره‌ها و آپلود ویدئو</span>
                </NavLink>
                <AuthorizeView Roles="Admin">
                    <Authorized Context="adminContext">
                <NavLink href="/admin/orders"
                         class="admin-sidebar-link"
                         ActiveClass="admin-sidebar-link-active">
                    <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Class="admin-sidebar-icon" />
                    <span>سفارش‌ها</span>
                </NavLink>
                    </Authorized>
                </AuthorizeView>
                <NavLink href="/portfolio"
                         class="admin-sidebar-link"
                         ActiveClass="admin-sidebar-link-active">
                    <MudIcon Icon="@Icons.Material.Filled.Palette" Class="admin-sidebar-icon" />
                    <span>نمونه‌کارها</span>
                </NavLink>
                <NavLink href="/admin/portfolio/add"
                         class="admin-sidebar-link"
                         ActiveClass="admin-sidebar-link-active">
                    <MudIcon Icon="@Icons.Material.Filled.AddPhotoAlternate" Class="admin-sidebar-icon" />
                    <span>افزودن نمونه‌کار</span>
                </NavLink>
            </nav>

            <div class="admin-sidebar-footer">
                <NavLink href="/profile"
                         class="admin-sidebar-link"
                         ActiveClass="admin-sidebar-link-active">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Class="admin-sidebar-icon" />
                    <span>پروفایل من</span>
                </NavLink>
                <NavLink href="/" class="admin-sidebar-link">
                    <MudIcon Icon="@Icons.Material.Filled.Home" Class="admin-sidebar-icon" />
                    <span>مشاهده سایت</span>
                </NavLink>
                <button type="button" class="admin-sidebar-logout" @onclick="LogoutAsync">
                    <MudIcon Icon="@Icons.Material.Filled.Logout" Class="admin-sidebar-icon" />
                    <span>خروج از حساب</span>
                </button>
            </div>
        </aside>
            </Authorized>
        </AuthorizeView>


        <!-- ================================================= -->
        <!-- Main Content -->
        <!-- ================================================= -->

        <MudMainContent>

            <div class="main-content">

                <div class="main-content-inner">

                    @Body

                </div>

            </div>

        </MudMainContent>


        <!-- ================================================= -->
        <!-- Mobile Admin Navigation -->
        <!-- ================================================= -->

        <AuthorizeView Roles="Admin,Instructor">
            <Authorized Context="staffContext">
                <AdminBottomNavigation />
            </Authorized>
        </AuthorizeView>

    </MudLayout>

</MudRTLProvider>


@code {

    [Inject] private ThemePreferenceService ThemePreference { get; set; } = default!;

    protected override void OnInitialized()
    {
        ThemePreference.Changed += OnThemeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await ThemePreference.InitializeAsync();
    }

    private void OnThemeChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => ThemePreference.Changed -= OnThemeChanged;

    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();

        NavigationManager.NavigateTo(
            "/",
            forceLoad: true);
    }

}
