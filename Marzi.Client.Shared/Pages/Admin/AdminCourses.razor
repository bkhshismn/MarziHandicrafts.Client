@page "/admin/courses"
@layout AdminLayout

@using Marzi.Client.Core.Models.Courses
@using Marzi.Client.Infrastructure.Api
@using Marzi.Client.Infrastructure.Services
@using Marzi.Client.Shared.Components.Courses
@using Marzi.Client.Shared.Layouts
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using MudBlazor

@inject CourseService CourseService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS


<AuthorizeView Roles="Admin,Instructor">

    <Authorized>

        <MudContainer MaxWidth="MaxWidth.False"
                      Class="admin-courses-container">

            <MudStack Spacing="4">

                <!-- ================================================= -->
                <!-- Header -->
                <!-- ================================================= -->

                <MudStack Row="true"
                          AlignItems="AlignItems.Center"
                          Justify="Justify.SpaceBetween">

                    <div>

                        <MudText Typo="Typo.h4">
                            مدیریت دوره‌ها
                        </MudText>

                        <MudText Typo="Typo.body2"
                                 Color="Color.Secondary">

                            مدیریت دوره‌ها، فصل‌ها، درس‌ها و ویدئوهای آموزشی

                        </MudText>

                    </div>


                    <MudStack Row="true"
                              AlignItems="AlignItems.Center"
                              Spacing="2">

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="OpenCreateCourse">

                            ایجاد دوره

                        </MudButton>


                        @if (!_loading)
                        {
                            <MudChip T="string"
                                     Color="Color.Primary"
                                     Variant="Variant.Outlined">

                                @_courses.Count دوره

                            </MudChip>
                        }

                    </MudStack>

                </MudStack>


                <!-- ================================================= -->
                <!-- Error -->
                <!-- ================================================= -->
                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error"
                              Variant="Variant.Filled">

                        @_errorMessage

                    </MudAlert>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="LoadCourses">

                        تلاش مجدد

                    </MudButton>
                }


                <!-- ================================================= -->
                <!-- Loading -->
                <!-- ================================================= -->
                @if (_loading)
                {
                    <MudStack Spacing="2">

                        <MudSkeleton Height="80px"
                                     Animation="Animation.Wave" />

                        <MudSkeleton Height="80px"
                                     Animation="Animation.Wave" />

                        <MudSkeleton Height="80px"
                                     Animation="Animation.Wave" />

                    </MudStack>
                }


                <!-- ================================================= -->
                <!-- Empty -->
                <!-- ================================================= -->
                @if (!_loading && _courses.Count == 0)
                {
                    <MudPaper Class="pa-8 text-center"
                              Elevation="1">

                        <MudIcon Icon="@Icons.Material.Filled.School"
                                 Size="Size.Large"
                                 Color="Color.Secondary" />

                        <MudText Typo="Typo.h6"
                                 Class="mt-3">

                            هنوز دوره‌ای برای مدیریت وجود ندارد.

                        </MudText>

                        <MudText Typo="Typo.body2"
                                 Color="Color.Secondary"
                                 Class="mt-2">

                            برای شروع، یک دوره جدید ایجاد کنید.

                        </MudText>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   Class="mt-4"
                                   OnClick="OpenCreateCourse">

                            ایجاد اولین دوره

                        </MudButton>

                    </MudPaper>
                }


                <!-- ================================================= -->
                <!-- Courses -->
                <!-- ================================================= -->
                @if (!_loading && _courses.Count > 0)
                {
                    <MudGrid>

                        <!-- ================================================= -->
                        <!-- Course List -->
                        <!-- ================================================= -->

                        <MudItem xs="12"
                                 md="4"
                                 lg="3">

                            <MudPaper Class="pa-3"
                                      Elevation="1">

                                <MudText Typo="Typo.h6"
                                         Class="mb-3">

                                    دوره‌ها

                                </MudText>


                                <MudStack Spacing="1">

                                    @foreach (var course in _courses)
                                    {
                                        <MudButton Variant="@GetCourseButtonVariant(course)"
                                                   Color="Color.Primary"
                                                   FullWidth="true"
                                                   Class="justify-start"
                                                   OnClick="@(() => SelectCourse(course))">

                                            <MudStack Row="true"
                                                      AlignItems="AlignItems.Center"
                                                      Spacing="2">

                                                <MudIcon Icon="@Icons.Material.Filled.School"
                                                         Size="Size.Small" />

                                                <span>
                                                    @course.Title
                                                </span>

                                            </MudStack>

                                        </MudButton>
                                    }

                                </MudStack>

                            </MudPaper>

                        </MudItem>


                        <!-- ================================================= -->
                        <!-- Selected Course Area -->
                        <!-- ================================================= -->

                        <MudItem xs="12"
                                 md="8"
                                 lg="9">

                            @if (_selectedCourse is null)
                            {
                                <MudPaper Class="pa-8 text-center"
                                          Elevation="1">

                                    <MudIcon Icon="@Icons.Material.Filled.TouchApp"
                                             Size="Size.Large"
                                             Color="Color.Secondary" />

                                    <MudText Typo="Typo.h6"
                                             Class="mt-3">

                                        یک دوره را انتخاب کنید

                                    </MudText>

                                    <MudText Typo="Typo.body2"
                                             Color="Color.Secondary">

                                        برای مدیریت سرفصل‌ها، درس‌ها و ویدئوها،
                                        ابتدا یک دوره را انتخاب کنید.

                                    </MudText>

                                </MudPaper>
                            }


                            @if (_selectedCourse is not null)
                            {
                                <MudStack Spacing="3">

                                    <!-- ============================================= -->
                                    <!-- Course Information -->
                                    <!-- ============================================= -->

                                    <MudPaper Class="pa-4"
                                              Elevation="1">

                                        <MudStack Class="course-info-header"
                                                  AlignItems="AlignItems.Center"
                                                  Justify="Justify.SpaceBetween">

                                            <div class="course-info-title">

                                                <MudText Typo="Typo.h5">

                                                    @_selectedCourse.Title

                                                </MudText>

                                                <MudText Typo="Typo.body2"
                                                         Color="Color.Secondary">

                                                    @_selectedCourse.Category

                                                    @if (!string.IsNullOrWhiteSpace(
                                                        _selectedCourse.Level))
                                                    {
                                                        <span>
                                                            · @_selectedCourse.Level
                                                        </span>
                                                    }

                                                </MudText>

                                            </div>


                                            <MudStack Row="true"
                                                      Class="course-info-controls"
                                                      AlignItems="AlignItems.Center"
                                                      Spacing="2">

                                                @if (_selectedCourse.IsPublished)
                                                {
                                                    <MudChip T="string"
                                                             Color="Color.Success"
                                                             Size="Size.Small">

                                                        منتشر شده

                                                    </MudChip>

                                                    <MudButton Variant="Variant.Outlined"
                                                               Color="Color.Warning"
                                                               Size="Size.Small"
                                                               Class="course-action-button"
                                                               StartIcon="@Icons.Material.Filled.VisibilityOff"
                                                               OnClick="TogglePublishedAsync"
                                                               Disabled="_publishingCourse">

                                                        لغو انتشار

                                                    </MudButton>
                                                }
                                                else
                                                {
                                                    <MudChip T="string"
                                                             Color="Color.Warning"
                                                             Size="Size.Small">

                                                        منتشر نشده

                                                    </MudChip>

                                                    <MudButton Variant="Variant.Filled"
                                                               Color="Color.Success"
                                                               Size="Size.Small"
                                                               Class="course-action-button"
                                                               StartIcon="@Icons.Material.Filled.Publish"
                                                               OnClick="TogglePublishedAsync"
                                                               Disabled="_publishingCourse">

                                                        انتشار دوره

                                                    </MudButton>
                                                }

                                                <MudButton Variant="Variant.Outlined"
                                                           Color="Color.Error"
                                                           Size="Size.Small"
                                                           StartIcon="@Icons.Material.Filled.Delete"
                                                           OnClick="DeleteSelectedCourseAsync"
                                                           Disabled="_deletingCourse">

                                                    @if (_deletingCourse)
                                                    {
                                                        <MudProgressCircular Size="Size.Small"
                                                                             Indeterminate="true" />
                                                    }
                                                    else
                                                    {
                                                        <span>حذف دوره</span>
                                                    }

                                                </MudButton>


                                                <MudChip T="string"
                                                         Color="Color.Primary"
                                                         Variant="Variant.Outlined"
                                                         Size="Size.Small">

                                                    @_sections.Count بخش

                                                </MudChip>

                                            </MudStack>

                                        </MudStack>

                                    </MudPaper>


                                    <!-- ============================================= -->
                                    <!-- Sections Header -->
                                    <!-- ============================================= -->

                                    <MudPaper Class="pa-4"
                                              Elevation="1">

                                        <MudStack Row="true"
                                                  AlignItems="AlignItems.Center"
                                                  Justify="Justify.SpaceBetween">

                                            <div>

                                                <MudText Typo="Typo.h6">

                                                    سرفصل‌ها

                                                </MudText>

                                                <MudText Typo="Typo.body2"
                                                         Color="Color.Secondary">

                                                    بخش‌های آموزشی این دوره را مدیریت کنید.

                                                </MudText>

                                            </div>


                                            <MudButton Variant="Variant.Filled"
                                                       Color="Color.Primary"
                                                       StartIcon="@Icons.Material.Filled.Add"
                                                       OnClick="OpenAddSection">

                                                افزودن سرفصل

                                            </MudButton>

                                        </MudStack>

                                    </MudPaper>


                                    <!-- ============================================= -->
                                    <!-- Sections Loading -->
                                    <!-- ============================================= -->
                                    @if (_sectionsLoading)
                                    {
                                        <MudStack Spacing="2">

                                            <MudSkeleton Height="70px"
                                                         Animation="Animation.Wave" />

                                            <MudSkeleton Height="70px"
                                                         Animation="Animation.Wave" />

                                        </MudStack>
                                    }


                                    <!-- ============================================= -->
                                    <!-- No Sections -->
                                    <!-- ============================================= -->
                                    @if (!_sectionsLoading && _sections.Count == 0)
                                    {
                                        <MudAlert Severity="Severity.Info"
                                                  Variant="Variant.Outlined">

                                            این دوره هنوز هیچ سرفصلی ندارد.
                                                           Class="course-action-button"

                                        </MudAlert>
                                    }


                                    <!-- ============================================= -->
                                    <!-- Sections -->
                                    <!-- ============================================= -->
                                    @if (!_sectionsLoading && _sections.Count > 0)
                                    {
                                        <MudExpansionPanels MultiExpansion="true">

                                            @foreach (
                                                var section in _sections
                                                    .OrderBy(x => x.OrderIndex))
                                            {
                                                <MudExpansionPanel>

                                                    <TitleContent>

                                                        <MudStack Row="true"
                                                                  AlignItems="AlignItems.Center"
                                                                  Justify="Justify.SpaceBetween"
                                                                  Style="width:100%;">

                                                            <MudStack Row="true"
                                                                      AlignItems="AlignItems.Center"
                                                                      Spacing="2">

                                                                <MudAvatar Color="Color.Primary"
                                                                           Size="Size.Small">

                                                                    @section.OrderIndex

                                                                </MudAvatar>


                                                                <MudText Typo="Typo.body1">

                                                                    @section.Title

                                                                </MudText>

                                                            </MudStack>


                                                            <MudChip T="string"
                                                                     Size="Size.Small"
                                                                     Variant="Variant.Outlined">

                                                                @section.Lessons.Count درس

                                                            </MudChip>

                                                        </MudStack>

                                                    </TitleContent>


                                                    <ChildContent>

                                                        <MudStack Spacing="3">

                                                            <MudStack Row="true"
                                                                      AlignItems="AlignItems.Center"
                                                                      Justify="Justify.SpaceBetween">

                                                                <MudText Typo="Typo.subtitle2">

                                                                    درس‌های این سرفصل

                                                                </MudText>


                                                                <MudButton Variant="Variant.Outlined"
                                                                           Color="Color.Primary"
                                                                           Size="Size.Small"
                                                                           StartIcon="@Icons.Material.Filled.Add"
                                                                           OnClick="@(() => OpenAddLesson(section))">

                                                                    افزودن درس

                                                                </MudButton>

                                                            </MudStack>


                                                            @if (_loadingLessonsForSectionId == section.Id)
                                                            {
                                                                <MudSkeleton Height="60px"
                                                                             Animation="Animation.Wave" />
                                                            }


                                                            @if (_loadingLessonsForSectionId != section.Id &&
                                                                section.Lessons.Count == 0)
                                                            {
                                                                <MudText Typo="Typo.body2"
                                                                         Color="Color.Secondary"
                                                                         Class="pa-3">

                                                                    این سرفصل هنوز درسی ندارد.

                                                                </MudText>
                                                            }


                                                            @if (_loadingLessonsForSectionId != section.Id &&
                                                                section.Lessons.Count > 0)
                                                            {
                                                                <MudStack Spacing="2">

                                                                    @foreach (
                                                                        var lesson in section.Lessons
                                                                            .OrderBy(x => x.OrderIndex))
                                                                    {
                                                                        <MudPaper Class="lesson-admin-card pa-3"
                                                                                  Elevation="0">

                                                                            <MudStack Spacing="2">

                                                                                <MudStack Row="true"
                                                                                          AlignItems="AlignItems.Center"
                                                                                          Justify="Justify.SpaceBetween">

                                                                                    <MudStack Row="true"
                                                                                              AlignItems="AlignItems.Center"
                                                                                              Spacing="2">

                                                                                        <MudAvatar Color="Color.Primary"
                                                                                                   Size="Size.Small">

                                                                                            @lesson.OrderIndex

                                                                                        </MudAvatar>


                                                                                        <div>

                                                                                            <MudText Typo="Typo.body1">

                                                                                                @lesson.Title

                                                                                            </MudText>


                                                                                            @if (!string.IsNullOrWhiteSpace(
                                                                                                lesson.Description))
                                                                                            {
                                                                                                <MudText Typo="Typo.caption"
                                                                                                         Color="Color.Secondary">

                                                                                                    @lesson.Description

                                                                                                </MudText>
                                                                                            }

                                                                                        </div>

                                                                                    </MudStack>


                                                                                    @if (lesson.HasVideo)
                                                                                    {
                                                                                        <MudChip T="string"
                                                                                                 Color="Color.Success"
                                                                                                 Size="Size.Small">

                                                                                            ویدئو دارد

                                                                                        </MudChip>
                                                                                    }


                                                                                    @if (!lesson.HasVideo)
                                                                                    {
                                                                                        <MudChip T="string"
                                                                                                 Color="Color.Default"
                                                                                                 Size="Size.Small">

                                                                                            بدون ویدئو

                                                                                        </MudChip>
                                                                                    }

                                                                                </MudStack>


                                                                                <LessonVideoUpload Lesson="lesson"
                                                                                                   OnUploaded="OnVideoUploaded" />

                                                                            </MudStack>

                                                                        </MudPaper>
                                                                    }

                                                                </MudStack>
                                                            }

                                                        </MudStack>

                                                    </ChildContent>

                                                </MudExpansionPanel>
                                            }

                                        </MudExpansionPanels>
                                    }

                                </MudStack>
                            }

                        </MudItem>

                    </MudGrid>
                }

            </MudStack>

        </MudContainer>

    </Authorized>


    <!-- ========================================================= -->
    <!-- Not Authorized -->
    <!-- ========================================================= -->

    <NotAuthorized>

        <MudContainer MaxWidth="MaxWidth.Medium"
                      Class="pa-6">

            <MudPaper Class="pa-8 text-center"
                      Elevation="1">

                <MudIcon Icon="@Icons.Material.Filled.Lock"
                         Size="Size.Large"
                         Color="Color.Error" />

                <MudText Typo="Typo.h5"
                         Class="mt-4">

                    دسترسی غیرمجاز

                </MudText>

                <MudText Typo="Typo.body2"
                         Color="Color.Secondary"
                         Class="mt-2">

                    شما اجازه دسترسی به پنل مدیریت دوره‌ها را ندارید.

                </MudText>

                <MudButton Href="/"
                           Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Class="mt-4">

                    بازگشت به سایت

                </MudButton>

            </MudPaper>

        </MudContainer>

    </NotAuthorized>

</AuthorizeView>


<!-- ============================================================ -->
<!-- Create Course Dialog -->
<!-- ============================================================ -->

<MudDialog @bind-Visible="_showCreateCourseDialog">

    <TitleContent>

        ایجاد دوره جدید

    </TitleContent>


    <DialogContent>

        <MudStack Spacing="3">

            <MudTextField @bind-Value="_courseTitle"
                          Label="عنوان دوره"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Required="true" />


            <MudTextField @bind-Value="_courseDescription"
                          Label="توضیحات دوره"
                          Variant="Variant.Outlined"
                          Lines="4"
                          FullWidth="true"
                          Required="true" />


            <MudTextField @bind-Value="_courseCoverImageUrl"
                          Label="آدرس تصویر کاور"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Placeholder="https://..." />


            <MudNumericField T="decimal"
                             @bind-Value="_coursePrice"
                             Label="قیمت دوره"
                             Variant="Variant.Outlined"
                             Min="0"
                             FullWidth="true" />


            <MudNumericField T="int"
                             @bind-Value="_courseDurationMinutes"
                             Label="مدت دوره به دقیقه"
                             Variant="Variant.Outlined"
                             Min="0"
                             FullWidth="true" />


            <MudSwitch T="bool"
                       @bind-Value="_courseIsPublished"
                       Color="Color.Primary">

                انتشار دوره

            </MudSwitch>


            @if (!string.IsNullOrWhiteSpace(_courseDialogError))
            {
                <MudAlert Severity="Severity.Error"
                          Variant="Variant.Outlined">

                    @_courseDialogError

                </MudAlert>
            }

        </MudStack>

    </DialogContent>


    <DialogActions>

        <MudButton Variant="Variant.Text"
                   OnClick="CloseCreateCourse"
                   Disabled="_courseCreating">

            انصراف

        </MudButton>


        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="CreateCourse"
                   Disabled="_courseCreating">

            @if (_courseCreating)
            {
                <MudProgressCircular Size="Size.Small"
                                     Indeterminate="true" />
            }

            @if (!_courseCreating)
            {
                <span>
                    ایجاد دوره
                </span>
            }

        </MudButton>

    </DialogActions>

</MudDialog>


<!-- ============================================================ -->
<!-- Add Section Dialog -->
<!-- ============================================================ -->

<MudDialog @bind-Visible="_showSectionDialog">

    <TitleContent>

        افزودن سرفصل

    </TitleContent>


    <DialogContent>

        <MudStack Spacing="3">

            <MudTextField @bind-Value="_sectionTitle"
                          Label="عنوان سرفصل"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Required="true" />


            <MudNumericField T="int"
                             @bind-Value="_sectionOrder"
                             Label="ترتیب"
                             Variant="Variant.Outlined"
                             Min="1"
                             FullWidth="true" />


            @if (!string.IsNullOrWhiteSpace(_dialogError))
            {
                <MudAlert Severity="Severity.Error"
                          Variant="Variant.Outlined">

                    @_dialogError

                </MudAlert>
            }

        </MudStack>

    </DialogContent>


    <DialogActions>

        <MudButton Variant="Variant.Text"
                   OnClick="CloseSectionDialog"
                   Disabled="_dialogSaving">

            انصراف

        </MudButton>


        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="CreateSection"
                   Disabled="_dialogSaving">

            ذخیره سرفصل

        </MudButton>

    </DialogActions>

</MudDialog>


<!-- ============================================================ -->
<!-- Add Lesson Dialog -->
<!-- ============================================================ -->

<MudDialog @bind-Visible="_showLessonDialog">

    <TitleContent>

        افزودن درس

    </TitleContent>


    <DialogContent>

        <MudStack Spacing="3">

            @if (_selectedSectionForLesson is not null)
            {
                <MudAlert Severity="Severity.Info"
                          Variant="Variant.Outlined">

                    سرفصل:

                    <strong>
                        @_selectedSectionForLesson.Title
                    </strong>

                </MudAlert>
            }


            <MudTextField @bind-Value="_lessonTitle"
                          Label="عنوان درس"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Required="true" />


            <MudTextField @bind-Value="_lessonDescription"
                          Label="توضیحات"
                          Variant="Variant.Outlined"
                          Lines="3"
                          FullWidth="true" />


            <MudNumericField T="int"
                             @bind-Value="_lessonDuration"
                             Label="مدت درس به ثانیه"
                             Variant="Variant.Outlined"
                             Min="0"
                             FullWidth="true" />


            <MudNumericField T="int"
                             @bind-Value="_lessonOrder"
                             Label="ترتیب"
                             Variant="Variant.Outlined"
                             Min="1"
                             FullWidth="true" />


            <MudSwitch T="bool"
                       @bind-Value="_lessonIsFreePreview"
                       Color="Color.Primary">

                پیش‌نمایش رایگان

            </MudSwitch>


            @if (!string.IsNullOrWhiteSpace(_dialogError))
            {
                <MudAlert Severity="Severity.Error"
                          Variant="Variant.Outlined">

                    @_dialogError

                </MudAlert>
            }

        </MudStack>

    </DialogContent>


    <DialogActions>

        <MudButton Variant="Variant.Text"
                   OnClick="CloseLessonDialog"
                   Disabled="_dialogSaving">

            انصراف

        </MudButton>


        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="CreateLesson"
                   Disabled="_dialogSaving">

            ذخیره درس

        </MudButton>

    </DialogActions>

</MudDialog>


@code {

    // ============================================================
    // Courses
    // ============================================================

    private IReadOnlyList<CourseDto> _courses = [];

    private CourseDto? _selectedCourse;

    private bool _loading = true;

    private string? _errorMessage;
    private bool _publishingCourse;
    private bool _deletingCourse;

    // ============================================================
    // Create Course
    // ============================================================

    private bool _showCreateCourseDialog;

    private bool _courseCreating;

    private string _courseTitle = string.Empty;

    private string _courseDescription = string.Empty;

    private string _courseCoverImageUrl = string.Empty;

    private decimal _coursePrice;

    private int _courseDurationMinutes;

    private bool _courseIsPublished;

    private string? _courseDialogError;


    // ============================================================
    // Sections
    // ============================================================

    private IReadOnlyList<CourseSectionDto> _sections = [];

    private bool _sectionsLoading;

    private bool _showSectionDialog;

    private string _sectionTitle = string.Empty;

    private int _sectionOrder = 1;


    // ============================================================
    // Lessons
    // ============================================================

    private CourseSectionDto? _selectedSectionForLesson;

    private Guid? _loadingLessonsForSectionId;

    private bool _showLessonDialog;

    private string _lessonTitle = string.Empty;

    private string? _lessonDescription;

    private int _lessonDuration;

    private int _lessonOrder = 1;

    private bool _lessonIsFreePreview;


    // ============================================================
    // Dialog
    // ============================================================

    private bool _dialogSaving;

    private string? _dialogError;


    // ============================================================
    // Initialization
    // ============================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadCourses();
    }


    // ============================================================
    // Load Courses
    // ============================================================

    private async Task LoadCourses()
    {
        _loading = true;

        _errorMessage = null;

        try
        {
            _courses =
                await CourseService.GetAllAsync();

            if (_selectedCourse is not null)
            {
                var selectedId =
                    _selectedCourse.Id;

                var updatedCourse =
                    _courses.FirstOrDefault(
                        x => x.Id == selectedId);

                _selectedCourse =
                    updatedCourse;

                if (_selectedCourse is not null)
                {
                    await LoadSections();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[ADMIN COURSES] Load failed: {ex}");

            _errorMessage =
                ex.Message;

            Snackbar.Add(
                ex.Message,
                Severity.Error);
        }
        finally
        {
            _loading = false;
