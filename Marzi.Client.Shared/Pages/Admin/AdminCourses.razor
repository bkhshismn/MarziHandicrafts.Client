    // ============================================================
    // Select Course
    // ============================================================

    private async Task SelectCourse(
        CourseDto course)
    {
        _selectedCourse =
            course;

        _sections =
            [];

        await LoadSections();
    }


    // ============================================================
    // Load Sections
    // ============================================================
    private async Task LoadSections()
    {
        if (_selectedCourse is null)
            return;

        _sectionsLoading = true;

        try
        {
            // دریافت سرفصل‌ها
            var sections =
                await CourseService.GetSectionsAsync(
                    _selectedCourse.Id);

            var orderedSections =
                sections
                    .OrderBy(x => x.OrderIndex)
                    .ToList();

            // دریافت درس‌های هر سرفصل
            foreach (var section in orderedSections)
            {
                try
                {
                    var lessons =
                        await CourseService.GetLessonsAsync(
                            section.Id);

                    section.Lessons =
                        lessons
                            .OrderBy(x => x.OrderIndex)
                            .ToList();

                    Console.WriteLine(
                        $"[ADMIN COURSES] Section: {section.Title} | Lessons: {section.Lessons.Count}");
                }
                catch (Exception ex)
                {
                    Console.WriteLine(
                        $"[ADMIN COURSES] Load lessons failed for section {section.Id}: {ex}");

                    section.Lessons = [];
                }
            }

            _sections =
                orderedSections;

            // همگام‌سازی اطلاعات دوره
            _selectedCourse.Sections =
                _sections.ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[ADMIN COURSES] Load sections failed: {ex}");

            Snackbar.Add(
                ex.Message,
                Severity.Error);
        }
        finally
        {
            _sectionsLoading = false;
        }
    }


    // ============================================================
    // Load Lessons
    // ============================================================

    private async Task LoadLessons(
        CourseSectionDto section)
    {
        _loadingLessonsForSectionId =
            section.Id;

        try
        {
            var lessons =
                await CourseService.GetLessonsAsync(
                    section.Id);

            section.Lessons =
                lessons
                    .OrderBy(x => x.OrderIndex)
                    .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[ADMIN COURSES] Load lessons failed: {ex}");

            Snackbar.Add(
                ex.Message,
                Severity.Error);
        }
        finally
        {
            _loadingLessonsForSectionId =
                null;
        }
    }


    // ============================================================
    // Create Course
    // ============================================================

    private void OpenCreateCourse()
    {
        _courseTitle =
            string.Empty;

        _courseDescription =
            string.Empty;

        _courseCoverImageUrl =
            string.Empty;

        _coursePrice =
            0;

        _courseDurationMinutes =
            0;

        _courseIsPublished =
            false;

        _courseDialogError =
            null;

        _showCreateCourseDialog =
            true;
    }


    private void CloseCreateCourse()
    {
        if (_courseCreating)
            return;

        _showCreateCourseDialog =
            false;

        _courseDialogError =
            null;
    }


    private async Task CreateCourse()
    {
        if (string.IsNullOrWhiteSpace(
            _courseTitle))
        {
            _courseDialogError =
                "عنوان دوره را وارد کنید.";

            return;
        }

        if (string.IsNullOrWhiteSpace(
            _courseDescription))
        {
            _courseDialogError =
                "توضیحات دوره را وارد کنید.";

            return;
        }

        _courseCreating =
            true;

        _courseDialogError =
            null;

        try
        {
            var request =
                new CourseCreateRequest
                {
                    Title =
                        _courseTitle.Trim(),

                    Description =
                        _courseDescription.Trim(),

                    CoverImageUrl =
                        string.IsNullOrWhiteSpace(
                            _courseCoverImageUrl)
                            ? string.Empty
                            : _courseCoverImageUrl.Trim(),

                    Price =
                        _coursePrice,

                    IsPublished =
                        _courseIsPublished,

                    DurationMinutes =
                        _courseDurationMinutes
                };

            var createdCourse =
                await CourseService.CreateAsync(
                    request);

            _showCreateCourseDialog =
                false;

            Snackbar.Add(
                "دوره با موفقیت ایجاد شد.",
                Severity.Success);

            await LoadCourses();

            var newCourse =
                _courses.FirstOrDefault(
                    x => x.Id == createdCourse.Id);

            if (newCourse is not null)
            {
                await SelectCourse(
                    newCourse);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[ADMIN COURSES] Create course failed: {ex}");

            _courseDialogError =
                ex.Message;

            Snackbar.Add(
                ex.Message,
                Severity.Error);
        }
        finally
        {
            _courseCreating =
                false;
        }
    }


