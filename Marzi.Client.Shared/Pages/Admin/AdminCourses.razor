    private async Task TogglePublishedAsync()
    {
        if (_selectedCourse is null)
            return;

        _publishingCourse = true;

        try
        {
            var newPublishedState =
                !_selectedCourse.IsPublished;

            var updatedCourse =
                await CourseService.SetPublishedAsync(
                    _selectedCourse.Id,
                    newPublishedState);

            _selectedCourse = updatedCourse;

            Snackbar.Add(
                newPublishedState
                    ? "دوره با موفقیت منتشر شد."
                    : "انتشار دوره لغو شد.",
                Severity.Success);

            await LoadCourses();

            var refreshedCourse =
                _courses.FirstOrDefault(
                    x => x.Id == updatedCourse.Id);

            if (refreshedCourse is not null)
                _selectedCourse = refreshedCourse;
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[ADMIN COURSES] Publish state change failed: {ex}");

            Snackbar.Add(
                ex.Message,
                Severity.Error);
        }
        finally
        {
            _publishingCourse = false;
        }
    }

    private async Task DeleteSelectedCourseAsync()
    {
        if (_selectedCourse is null || _deletingCourse)
            return;

        var courseTitle = _selectedCourse.Title;
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"آیا از حذف دوره «{courseTitle}» و تمام فصل‌ها، درس‌ها و ویدئوهای آن مطمئن هستید؟");

        if (!confirmed)
            return;

        _deletingCourse = true;

        try
        {
            await CourseService.DeleteAsync(_selectedCourse.Id);
            _selectedCourse = null;
            _sections = [];

            Snackbar.Add("دوره و محتوای آن با موفقیت حذف شد.", Severity.Success);
            await LoadCourses();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ADMIN COURSES] Delete failed: {ex}");
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _deletingCourse = false;
        }
    }
