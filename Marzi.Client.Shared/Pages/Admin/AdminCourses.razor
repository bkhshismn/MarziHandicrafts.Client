@code {

    // ============================================================
    // Courses
    // ============================================================

    private IReadOnlyList<CourseDto> _courses = [];

    private CourseDto? _selectedCourse;

    private bool _loading = true;

    private string? _errorMessage;


    // ============================================================
    // Sections
    // ============================================================

    private IReadOnlyList<CourseSectionDto> _sections = [];

    private bool _sectionsLoading;

    private bool _showSectionDialog;

    private string _sectionTitle = string.Empty;

    private int _sectionOrder = 1;


    // ============================================================
    // Lessons
    // ============================================================

    private CourseSectionDto? _selectedSectionForLesson;

    private Guid? _loadingLessonsForSectionId;

    private bool _showLessonDialog;

    private string _lessonTitle = string.Empty;

    private string? _lessonDescription;

    private int _lessonDuration;

    private int _lessonOrder = 1;

    private bool _lessonIsFreePreview;


    // ============================================================
    // Dialog State
    // ============================================================

    private bool _dialogSaving;

    private string? _dialogError;


    // ============================================================
    // Initialization
    // ============================================================

    protected override async Task OnInitializedAsync()
    {
        await DebugAuthentication();

        await LoadCourses();
    }


    // ============================================================
    // Authentication Debug
    // ============================================================

    private async Task DebugAuthentication()
    {
        try
        {
            var state =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            var user = state.User;

            Console.WriteLine(
                "================ ADMIN PAGE AUTH DEBUG ================");

            Console.WriteLine(
                $"[ADMIN PAGE] IsAuthenticated: {user.Identity?.IsAuthenticated}");

            Console.WriteLine(
                $"[ADMIN PAGE] AuthenticationType: {user.Identity?.AuthenticationType}");

            Console.WriteLine(
                $"[ADMIN PAGE] Name: {user.Identity?.Name}");

            Console.WriteLine(
                $"[ADMIN PAGE] IsAdmin: {user.IsInRole("Admin")}");

            Console.WriteLine(
                $"[ADMIN PAGE] IsInstructor: {user.IsInRole("Instructor")}");

            foreach (var claim in user.Claims)
            {
                Console.WriteLine(
                    $"[ADMIN PAGE CLAIM] {claim.Type} = {claim.Value}");
            }

            Console.WriteLine(
                "========================================================");
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[ADMIN PAGE AUTH ERROR] {ex}");
        }
    }


    // ============================================================
    // Load Courses
    // ============================================================

    private async Task LoadCourses()
    {
        _loading = true;
        _errorMessage = null;

        try
        {
            _courses =
                await CourseService.GetAllAsync();

            if (_selectedCourse is not null)
            {
                var selectedId =
                    _selectedCourse.Id;

                _selectedCourse =
                    _courses.FirstOrDefault(
                        x => x.Id == selectedId);

                if (_selectedCourse is not null)
                {
                    await LoadSections();
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;

            Snackbar.Add(
                ex.Message,
                Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }


    // ============================================================
    // Select Course
    // ============================================================

    private async Task SelectCourse(CourseDto course)
    {
        _selectedCourse = course;

        _sections = [];

        await LoadSections();
    }


    // ============================================================
    // Load Sections
    // ============================================================

    private async Task LoadSections()
    {
        if (_selectedCourse is null)
            return;

        _sectionsLoading = true;

        try
        {
            _sections =
                await CourseService.GetSectionsAsync(
                    _selectedCourse.Id);

            foreach (var section in _sections)
            {
                section.Lessons = [];
            }

            _selectedCourse.Sections =
                _sections.ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                ex.Message,
                Severity.Error);
        }
        finally
        {
            _sectionsLoading = false;
        }
    }


    // ============================================================
    // Load Lessons
    // ============================================================

    private async Task LoadLessons(
        CourseSectionDto section)
    {
        _loadingLessonsForSectionId =
            section.Id;

        try
        {
            var lessons =
                await CourseService.GetLessonsAsync(
                    section.Id);

            section.Lessons =
                lessons.ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                ex.Message,
                Severity.Error);
        }
        finally
        {
            _loadingLessonsForSectionId = null;
        }
    }


    // ============================================================
    // Section Dialog
    // ============================================================

    private void OpenAddSection()
    {
        if (_selectedCourse is null)
            return;

        _sectionTitle = string.Empty;

        _sectionOrder =
            _sections.Count == 0
                ? 1
                : _sections.Max(x => x.OrderIndex) + 1;

        _dialogError = null;

        _showSectionDialog = true;
    }


    private void CloseSectionDialog()
    {
        if (_dialogSaving)
            return;

        _showSectionDialog = false;

        _dialogError = null;
    }


    private async Task CreateSection()
    {
        if (_selectedCourse is null)
            return;

        if (string.IsNullOrWhiteSpace(_sectionTitle))
        {
            _dialogError =
                "Ø¹Ù†ÙˆØ§Ù† Ø³Ø±ÙØµÙ„ Ø±Ø§ ÙˆØ§Ø±Ø¯ Ú©Ù†ÛŒØ¯.";

            return;
        }

        _dialogSaving = true;
        _dialogError = null;

        try
        {
            var request =
                new CourseSectionCreateRequest
                {
                    Title = _sectionTitle.Trim(),
                    OrderIndex = _sectionOrder
                };

            await CourseService.CreateSectionAsync(
                _selectedCourse.Id,
                request);

            _showSectionDialog = false;

            Snackbar.Add(
                "Ø³Ø±ÙØµÙ„ Ø¨Ø§ Ù…ÙˆÙÙ‚ÛŒØª Ø§ÛŒØ¬Ø§Ø¯ Ø´Ø¯.",
                Severity.Success);

            await LoadSections();
        }
        catch (Exception ex)
        {
            _dialogError = ex.Message;

            Snackbar.Add(
                ex.Message,
                Severity.Error);
        }
        finally
        {
            _dialogSaving = false;
        }
    }


    // ============================================================
    // Lesson Dialog
    // ============================================================

    private void OpenAddLesson(
        CourseSectionDto section)
    {
        _selectedSectionForLesson =
            section;

        _lessonTitle = string.Empty;

        _lessonDescription = null;

        _lessonDuration = 0;

        _lessonOrder =
            section.Lessons.Count == 0
                ? 1
                : section.Lessons.Max(
                    x => x.OrderIndex) + 1;

        _lessonIsFreePreview = false;

        _dialogError = null;

        _showLessonDialog = true;
    }


    private void CloseLessonDialog()
    {
        if (_dialogSaving)
            return;

        _showLessonDialog = false;

        _selectedSectionForLesson = null;

        _dialogError = null;
    }


    private async Task CreateLesson()
    {
        if (_selectedSectionForLesson is null)
            return;

        if (string.IsNullOrWhiteSpace(_lessonTitle))
        {
            _dialogError =
                "Ø¹Ù†ÙˆØ§Ù† Ø¯Ø±Ø³ Ø±Ø§ ÙˆØ§Ø±Ø¯ Ú©Ù†ÛŒØ¯.";

            return;
        }

        _dialogSaving = true;
        _dialogError = null;

        try
        {
            var request =
                new CourseLessonCreateRequest
                {
                    Title =
                        _lessonTitle.Trim(),

                    Description =
                        string.IsNullOrWhiteSpace(
                            _lessonDescription)
                            ? null
                            : _lessonDescription.Trim(),

                    DurationSeconds =
                        _lessonDuration,

                    IsFreePreview =
                        _lessonIsFreePreview,

                    OrderIndex =
                        _lessonOrder
                };

            await CourseService.CreateLessonAsync(
                _selectedSectionForLesson.Id,
                request);

            var section =
                _selectedSectionForLesson;

            _showLessonDialog = false;

            _selectedSectionForLesson = null;

            Snackbar.Add(
                "Ø¯Ø±Ø³ Ø¨Ø§ Ù…ÙˆÙÙ‚ÛŒØª Ø§ÛŒØ¬Ø§Ø¯ Ø´Ø¯.",
                Severity.Success);

            await LoadLessons(section);
        }
        catch (Exception ex)
        {
            _dialogError = ex.Message;

            Snackbar.Add(
                ex.Message,
                Severity.Error);
        }
        finally
        {
            _dialogSaving = false;
        }
    }


