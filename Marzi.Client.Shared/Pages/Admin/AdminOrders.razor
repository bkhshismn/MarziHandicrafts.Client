    private async Task ShowOrderInfo(OrderDto order)
    {
        Console.WriteLine(
            $"[ADMIN ORDERS] SHOW CLICKED: {order.Id}");

        var parameters =
            new DialogParameters
            {
                ["Order"] = order
            };

        var options =
            new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseOnEscapeKey = true
            };

        var dialog =
            await DialogService.ShowAsync<OrderDetailsDialog>(
                "Ù…Ø¯ÛŒØ±ÛŒØª Ø³ÙØ§Ø±Ø´",
                parameters,
                options);

        var result =
            await dialog.Result;

        if (result is null ||
            result.Canceled)
        {
            return;
        }

        if (result.Data is OrderDto updatedOrder)
        {
            var index =
                _orders
                    .Select((item, i) => new
                    {
                        item,
                        i
                    })
                    .FirstOrDefault(x =>
                        x.item.Id == updatedOrder.Id)
                    ?.i ?? -1;

            if (index >= 0)
            {
                var updatedOrders =
                    _orders.ToList();

                updatedOrders[index] =
                    updatedOrder;

                _orders =
                    updatedOrders;
            }

            await InvokeAsync(
                StateHasChanged);
        }
    }


