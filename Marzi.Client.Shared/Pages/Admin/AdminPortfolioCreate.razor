@page "/admin/portfolio/add"
@layout AdminLayout

@using Marzi.Client.Infrastructure.Api
@using Marzi.Client.Infrastructure.Services
@using Marzi.Client.Shared.Layouts
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

@inject PortfolioService PortfolioService
@inject ICourseCategoriesApi CategoriesApi
@inject MediaService MediaService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<AuthorizeView Roles="Admin,Instructor">
    <Authorized>
        <MudContainer MaxWidth="MaxWidth.Medium" Class="py-6">
            <MudStack Spacing="4">
                <div>
                    <MudText Typo="Typo.h4">افزودن نمونه‌کار</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                        مشخصات اثر و آدرس تصویرهای آن را وارد کنید.
                    </MudText>
                </div>

                <MudPaper Class="pa-4 pa-md-6" Elevation="1">
                    @if (!string.IsNullOrWhiteSpace(_saveWarning))
                    {
                        <MudAlert Severity="Severity.Warning" Class="mb-4">
                            @_saveWarning
                            @if (_createdItemId.HasValue)
                            {
                                <MudButton Href="@($"/portfolio/{_createdItemId}")"
                                           Variant="Variant.Text"
                                           Color="Color.Inherit">
                                    مشاهده نمونه‌کار ثبت‌شده
                                </MudButton>
                            }
                        </MudAlert>
                    }

                    <MudForm @ref="_form">
                        <MudStack Spacing="3">
                            <MudTextField T="string"
                                          @bind-Value="_title"
                                          Label="عنوان نمونه‌کار"
                                          Variant="Variant.Outlined"
                                          Required="true"
                                          RequiredError="عنوان نمونه‌کار را وارد کنید."
                                          MaxLength="200" />

                            <MudSelect T="string" @bind-Value="_category" Label="دسته‌بندی" Variant="Variant.Outlined" Required="true">
                                @foreach (var category in _categories)
                                {
                                    <MudSelectItem T="string" Value="@category">@category</MudSelectItem>
                                }
                            </MudSelect>
                            @if (_categories.Count == 0)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Error">دسته‌بندی‌ای در سامانه پیدا نشد؛ ابتدا از بخش دسته‌بندی‌های دوره موردی اضافه کنید.</MudText>
                            }
                            @* Existing free text field replaced by the database-backed category list. *@
                            @* <MudTextField T="string" @bind-Value="_category"
                                          Label="دسته‌بندی"
                                          Placeholder="مثلاً مجسمه، چهره یا دکوراسیون"
                                          Variant="Variant.Outlined"
                                          Required="true"
                                          RequiredError="دسته‌بندی را وارد کنید."
                                          MaxLength="50" /> *@

                            <MudTextField T="string"
                                          @bind-Value="_description"
                                          Label="توضیحات"
                                          Variant="Variant.Outlined"
                                          Lines="5"
                                          Required="true"
                                          RequiredError="توضیحات نمونه‌کار را وارد کنید."
                                          MaxLength="1000" />

                            <MudDivider />

                            <MudStack Spacing="2">
                                <MudText Typo="Typo.h6">تصاویر محلی</MudText>
                                <InputFile OnChange="OnImagesSelected"
                                           accept="image/*"
                                           class="mobile-file-input"
                                           disabled="@_saving"
                                           multiple />
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    حداکثر ۱۲ تصویر، هرکدام تا ۱۰ مگابایت
                                </MudText>
                                @for (var index = 0; index < _selectedImages.Count; index++)
                                {
                                    var imageIndex = index;
                                    var image = _selectedImages[imageIndex];
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                        <MudText Typo="Typo.body2">@image.Name</MudText>
                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                       Color="Color.Error"
                                                       Disabled="_saving"
                                                       aria-label="حذف تصویر"
                                                       OnClick="@(() => RemoveImage(imageIndex))" />
                                    </MudStack>
                                }
                            </MudStack>

                            <MudSwitch T="bool"
                                       @bind-Value="_isVisible"
                                       Color="Color.Primary">
                                نمایش نمونه‌کار در سایت
                            </MudSwitch>

                            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                                <MudButton Variant="Variant.Text"
                                           Href="/portfolio">
                                    انصراف
                                </MudButton>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Disabled="_saving || _createdItemId.HasValue"
                                           OnClick="SaveAsync">
                                    @if (_saving)
                                    {
                                        <MudProgressCircular Indeterminate="true"
                                                             Size="Size.Small"
                                                             Class="me-2" />
                                    }
                                    ثبت نمونه‌کار
                                </MudButton>
                            </MudStack>
                        </MudStack>
                    </MudForm>
                </MudPaper>
            </MudStack>
        </MudContainer>
    </Authorized>

    <NotAuthorized>
        <MudContainer MaxWidth="MaxWidth.Small" Class="py-8">
            <MudAlert Severity="Severity.Error">
                برای افزودن نمونه‌کار باید با حساب مدیر یا مربی وارد شوید.
            </MudAlert>
            <MudButton Href="/login?returnUrl=%2Fadmin%2Fportfolio%2Fadd"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-4">
                ورود
            </MudButton>
        </MudContainer>
    </NotAuthorized>
</AuthorizeView>

@code {
    private MudForm? _form;
    private string _title = string.Empty;
    private string _category = string.Empty;
    private List<string> _categories = [];
    private string _description = string.Empty;
    private const int MaxImageCount = 12;
    private const long MaxImageUploadBytes = 10 * 1024 * 1024;
    private readonly List<IBrowserFile> _selectedImages = [];
    private bool _isVisible = true;
    private bool _saving;
    private Guid? _createdItemId;
    private string? _saveWarning;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await CategoriesApi.ListAsync();
            if (response.IsSuccessStatusCode && response.Content is not null)
            {
                _categories = response.Content.Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x).ToList();
                _category = _categories.FirstOrDefault() ?? string.Empty;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"دریافت دسته‌بندی‌ها ناموفق بود: {ex.Message}", Severity.Error);
        }
    }

    private void OnImagesSelected(InputFileChangeEventArgs args)
    {
        IReadOnlyList<IBrowserFile> files;
        try
        {
            files = args.GetMultipleFiles(MaxImageCount);
        }
        catch (InvalidOperationException)
        {
            Snackbar.Add($"حداکثر {MaxImageCount} تصویر می‌توانید انتخاب کنید.", Severity.Error);
            return;
        }

        foreach (var file in files)
        {
            if (_selectedImages.Count >= MaxImageCount)
            {
                Snackbar.Add($"حداکثر {MaxImageCount} تصویر مجاز است.", Severity.Warning);
                break;
            }

            if (file.Size > MaxImageUploadBytes)
            {
                Snackbar.Add($"فایل «{file.Name}» بیشتر از حد مجاز است.", Severity.Error);
                continue;
            }

            _selectedImages.Add(file);
        }
    }

    private void RemoveImage(int index)
    {
        if (index >= 0 && index < _selectedImages.Count)
            _selectedImages.RemoveAt(index);
    }

    private async Task SaveAsync()
    {
        if (_saving || _createdItemId.HasValue || _form is null)
            return;

        await _form.ValidateAsync();
        if (!_form.IsValid)
            return;

        if (_selectedImages.Count == 0)
        {
            Snackbar.Add(
                "حداقل یک تصویر انتخاب کنید.",
                Severity.Error);
            return;
        }

        var authState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        if (authState.User.Identity?.IsAuthenticated != true ||
            (!authState.User.IsInRole("Admin") &&
             !authState.User.IsInRole("Instructor")))
        {
            Snackbar.Add(
                "برای افزودن نمونه‌کار دسترسی لازم را ندارید.",
                Severity.Error);
            return;
        }

        _saving = true;
        try
        {
            var item = await PortfolioService.CreateAsync(
                new PortfolioCreateRequest(
                    _title.Trim(),
                    _category.Trim(),
                    _description.Trim(),
                    _isVisible));

            _createdItemId = item.Id;
            var imageErrors = new List<string>();

            for (var index = 0; index < _selectedImages.Count; index++)
            {
                try
                {
                    var file = _selectedImages[index];
                    await using var stream = file.OpenReadStream(MaxImageUploadBytes);
                    var imageUrl = await MediaService.UploadImageAsync(
                        stream,
                        file.Name,
                        file.ContentType);

                    await PortfolioService.AddImageAsync(
                        item.Id,
                        imageUrl);
                }
                catch (Exception ex)
                {
                    imageErrors.Add(
                        $"تصویر {index + 1}: {ex.Message}");
                }
            }

            if (imageErrors.Count > 0)
            {
                _saveWarning =
                    $"نمونه‌کار ثبت شد، اما افزودن تصویرها کامل نشد: " +
                    $"{string.Join("؛ ", imageErrors)} " +
                    "برای جلوگیری از ثبت تکراری، فرم قفل شده است.";

                return;
            }

            Snackbar.Add(
                "نمونه‌کار با موفقیت ثبت شد.",
                Severity.Success);

            Navigation.NavigateTo($"/portfolio/{item.Id}");
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                ex.Message,
                Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
