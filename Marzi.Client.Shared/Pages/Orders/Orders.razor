    // ============================================================

    private static Guid GetUserId(
        ClaimsPrincipal user)
    {
        var value =
            user.FindFirst(
                ClaimTypes.NameIdentifier)?.Value;

        if (Guid.TryParse(
                value,
                out var userId))
        {
            return userId;
        }


        value =
            user.FindFirst("sub")?.Value;

        if (Guid.TryParse(
                value,
                out userId))
        {
            return userId;
        }


        value =
            user.FindFirst("nameid")?.Value;

        if (Guid.TryParse(
                value,
                out userId))
        {
            return userId;
        }


        return Guid.Empty;
    }


