@page "/forgot-password"

<PageTitle>فراموشی رمز عبور | Marzi Handicrafts</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="login-page">
    <MudPaper Elevation="4" Class="login-card pa-6">
        <MudIcon Icon="@Icons.Material.Filled.LockReset" Color="Color.Primary" Size="Size.Large" />
        <MudText Typo="Typo.h5" Class="login-title">بازیابی رمز عبور</MudText>
        <MudText Typo="Typo.body1" Class="mt-4">
            برای حفظ امنیت حساب، بازیابی رمز باید با کد تأیید شمارهٔ موبایل انجام شود.
        </MudText>
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-4">
            بازیابی خودکار رمز هنوز فعال نشده است؛ در حال حاضر سامانه امکان ارسال کد تأیید پیامکی ندارد.
            لطفاً برای بازیابی حساب با پشتیبانی سایت تماس بگیرید.
        </MudAlert>
        <div class="d-flex justify-center gap-3 mt-6">
            <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary">بازگشت به ورود</MudButton>
            <MudButton Href="/" Variant="Variant.Text" Color="Color.Primary">صفحهٔ اصلی</MudButton>
        </div>
    </MudPaper>
</MudContainer>
