@page "/login"

@using Marzi.Client.Core.Requests
@using Marzi.Client.Infrastructure.Services
@using MudBlazor

@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@using Marzi.Client.Core.Authentication

@inject AuthService AuthService

<PageTitle>ورود | Marzi Handicrafts</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="login-page">

    <MudPaper Elevation="4" Class="login-card">

        @if (PasswordChanged)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-4">
                رمز عبور با موفقیت تغییر کرد. با رمز جدید وارد شوید.
            </MudAlert>
        }

        <div class="login-logo"></div>

        <MudText Typo="Typo.h5"
                 Align="Align.Center"
                 Class="login-title">
            ورود به Marzi Handicrafts
        </MudText>

        <MudText Typo="Typo.body2"
                 Align="Align.Center"
                 Class="login-subtitle">
            با نام کاربری و رمز عبور وارد شوید
        </MudText>

        <MudForm @ref="_form">

            <MudTextField T="string"
                          @bind-Value="_model.Phone"
                          Label="نام کاربری"
                          Variant="Variant.Outlined"
                          Margin="Margin.Normal"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Person"
                          InputType="InputType.Text"
                          Required="true"
                          RequiredError="شماره موبایل را وارد کنید"
                          Class="login-field"
                          FullWidth="true" />

            <MudTextField T="string"
                          @bind-Value="_model.Password"
                          Label="رمز عبور"
                          Variant="Variant.Outlined"
                          Margin="Margin.Normal"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showPassword
                                          ? Icons.Material.Filled.VisibilityOff
                                      : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="TogglePassword"
                          InputType="@(_showPassword
                                          ? InputType.Text
                                          : InputType.Password)"
                          Required="true"
                          RequiredError="رمز عبور را وارد کنید"
                          Class="login-field"
                          FullWidth="true" />

            <div class="login-options">
                <MudCheckBox T="bool"
                             @bind-Value="_rememberMe"
                             Label="مرا به خاطر بسپار"
                             Color="Color.Primary" />
            </div>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       Disabled="_loading"
                       OnClick="SubmitAsync"
                       Class="login-button">

                @if (_loading)
                {
                    <MudProgressCircular Indeterminate="true"
                                         Size="Size.Small"
                                         Class="me-2" />
                }

                ورود
            </MudButton>

        </MudForm>

        <div class="login-links">
            <MudLink Href="/register">
                ثبت نام
            </MudLink>

            <MudLink Href="/forgot-password">
                فراموشی رمز عبور
            </MudLink>
        </div>

    </MudPaper>

</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "passwordChanged")]
    public bool PasswordChanged { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private MudForm? _form;
    private readonly LoginRequest _model = new();

    private bool _showPassword;
    private bool _rememberMe;
    private bool _loading;

    private void TogglePassword()
    {
        _showPassword = !_showPassword;
    }

    private async Task SubmitAsync()
    {
        if (_form is null)
            return;

        await _form.ValidateAsync();
        if (!_form.IsValid)
            return;

        _loading = true;

        try
        {
            var result = await AuthService.LoginAsync(_model);

            if (result is null)
            {
                Snackbar.Add(
                    "شماره موبایل یا رمز عبور صحیح نیست.",
                    Severity.Error);

                return;
            }

            Snackbar.Add(
                "با موفقیت وارد شدید.",
                Severity.Success);

            Navigation.NavigateTo(
                GetSafeReturnUrl(),
                replace: true);
        }
        catch (Exception)
        {
            Snackbar.Add(
                "ارتباط با سرور برقرار نشد.",
                Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private string GetSafeReturnUrl()
    {
        if (!string.IsNullOrWhiteSpace(ReturnUrl) &&
            ReturnUrl.StartsWith("/", StringComparison.Ordinal) &&
            !ReturnUrl.StartsWith("//", StringComparison.Ordinal) &&
            !ReturnUrl.Contains('\\'))
        {
            return ReturnUrl;
        }

        return ReturnUrl switch
        {
            "/profile" => "/profile",
            "/admin" => "/admin",
            "/admin/courses" => "/admin/courses",
            "/admin/orders" => "/admin/orders",
            _ => "/"
        };
    }
}
