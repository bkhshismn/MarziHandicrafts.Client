@page "/courses/{Id:guid}"
@using Marzi.Client.Shared.Components.Courses

@layout Marzi.Client.Shared.Layouts.MainLayout

@using Marzi.Client.Core.Models.Courses
@using Marzi.Client.Infrastructure.Services

@inject CourseService CourseService
@inject ISnackbar Snackbar

<PageTitle>جزئیات دوره</PageTitle>

@if (_loading)
{
    <MudProgressCircular
        Indeterminate="true"
        Color="Color.Primary" />
}
else if (_course is null)
{
    <MudAlert Severity="Severity.Error">

        دوره پیدا نشد.

    </MudAlert>
}
else
{
    <CourseHero Course="_course" />

    <MudSpacer />

    <CourseInfoCard Course="_course" />

    <MudSpacer />

    <LessonList Sections="_course.Sections" />
}

@code{

    [Parameter]
    public Guid Id { get; set; }

    private CourseDto? _course;

    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;

        try
        {
            _course =
                await CourseService.GetByIdAsync(Id);
        }
        catch(Exception ex)
        {
            Snackbar.Add(
                ex.Message,
                Severity.Error);
        }

        _loading = false;
    }

}