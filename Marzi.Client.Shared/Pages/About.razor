@page "/about"

@using MudBlazor

<SeoHead Title="درباره کارگاه مرزی | هنر دست در جویبار" Path="/about"
         Description="با داستان کارگاه مرزی در زرین‌کلا، جویبار آشنا شوید؛ هنر دست‌ساز و ساخت آثار هنری با صبر و جزئیات." />

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6">

    <!-- Hero -->
    <MudPaper Class="pa-6 pa-md-8 mb-6" Elevation="1">
        <MudText Typo="Typo.h3" Class="mb-3">دربارهٔ مرزی</MudText>

        <MudText Typo="Typo.body1" Color="Color.Secondary">
            هنر دست، از دل مازندران؛ روایتی از پاپیه‌ماشه و فرم‌هایی که جان می‌گیرند.
        </MudText>
    </MudPaper>

    <MudGrid Spacing="4">

        <MudItem xs="12" md="7">
            <MudPaper Class="pa-6" Elevation="1">
                <MudText Typo="Typo.h5" Class="mb-4">داستان ما</MudText>

                <MudText Typo="Typo.body1" Class="mb-4">
                    «مرزی» از یک علاقهٔ ساده شروع شد: ساختن چهره‌هایی که فقط در ذهن بودند و
                    کم‌کم با کاغذ، چسب و صبر شکل گرفتند. امروز این کارگاه در
                    <strong>جویبارِ مازندران</strong> نفس می‌کشد؛ جایی که بوی کاغذ خمیرشده
                    و رنگ، بخشی از روزمرگی ماست.
                </MudText>

                <MudText Typo="Typo.body1" Class="mb-4">
                    تخصص ما <strong>پاپیه‌ماشه</strong> است؛ هنری که در آن لایه‌های نازک کاغذ
                    روی هم می‌نشینند تا فرمی سبک، محکم و زنده ساخته شود. از سردیس و پرتره‌های
                    واقع‌گرایانه تا ماسک‌های نمایشی و مجسمه‌های دکوراتیو؛ هر اثر با دست شکل
                    می‌گیرد، با دقت پرداخت می‌شود و بعد رنگ می‌خورد.
                </MudText>

                <MudText Typo="Typo.body1" Class="mb-4">
                    کنار خلق اثر، آموزش هم بخش مهمی از کار ماست. در
                    <strong>آموزشگاه آسمان</strong> همین هنر را قدم به قدم به علاقه‌مندان
                    منتقل می‌کنیم؛ از شناخت ابزار و ساخت فرم پایه تا پرداخت و رنگ‌آمیزی
                    حرفه‌ای. دوره‌های آنلاین همین سایت، همان مسیر را به خانه‌های شما می‌آورد.
                </MudText>

                <MudText Typo="Typo.body1">
                    اگر دنبال اثری هستید که فقط برای شما ساخته شده باشد،
                    <strong>سفارش سفارشی</strong> می‌پذیریم: عکس یا ایده‌ات را بفرست،
                    دربارهٔ اندازه، سبک و زمان تحویل صحبت می‌کنیم و بعد کار شروع می‌شود.
                </MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="5">
            <MudPaper Class="pa-6 mb-4" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-3">چه کارهایی انجام می‌دهیم</MudText>

                <MudList T="string" Dense="true">
                    <MudListItem T="string" Icon="@Icons.Material.Filled.CheckCircle">
                        سردیس و پرترهٔ پاپیه‌ماشه
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.CheckCircle">
                        ماسک‌های نمایشی و تزئینی
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.CheckCircle">
                        مجسمه‌های دکوراتیو و نقش‌برجسته
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.CheckCircle">
                        سفارش سفارشی بر اساس عکس یا ایده
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.CheckCircle">
                        آموزش پاپیه‌ماشه (حضوری و آنلاین)
                    </MudListItem>
                </MudList>
            </MudPaper>

            <MudPaper Class="pa-6" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-3">در یک نگاه</MudText>

                <MudStack Spacing="2">
                    <MudText Typo="Typo.body2">
                        <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" Class="me-1" />
                        مازندران، جویبار، زرین‌کلا، خیابان ورزش، کوچهٔ پونه، آموزشگاه آسمان
                    </MudText>

                    <MudText Typo="Typo.body2">
                        <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Class="me-1" />
                        <a href="tel:+989119009567" dir="ltr">+98 911 900 9567</a>
                    </MudText>

                    <MudText Typo="Typo.body2">
                        <MudIcon Icon="@Icons.Material.Filled.CameraAlt" Size="Size.Small" Class="me-1" />
                        <a href="https://www.instagram.com/marzi.handicrafts/"
                           target="_blank"
                           rel="noopener">
                            marzi.handicrafts
                        </a>
                    </MudText>
                </MudStack>

                <MudButton Href="/contact"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Chat"
                           Class="mt-4"
                           FullWidth="true">
                    گفتگو با ما
                </MudButton>
            </MudPaper>
        </MudItem>

    </MudGrid>

</MudContainer>
