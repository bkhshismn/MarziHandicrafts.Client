@page "/"
@layout Marzi.Client.Shared.Layouts.MainLayout
@using MudBlazor
@using Marzi.Client.Shared.Components.Common
@using Marzi.Client.Shared.Components.Cards

<HeroBanner />

<MudText Typo="Typo.h5" Class="mb-2">سلام 🌸</MudText>
<MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
    امروز آماده‌ای یک اثر هنری جدید خلق کنیم؟
</MudText>

<SectionTitle Title="دوره‌های آموزشی" ActionText="همه" ActionLink="/courses" />

<MudGrid Class="mb-4">
    <MudItem xs="12" sm="6" md="4" lg="3">
        <CourseCard />
    </MudItem>

    <MudItem xs="12" sm="6" md="4" lg="3">
        <CourseCard />
    </MudItem>
</MudGrid>

<SectionTitle Title="نمونه کارها" ActionText="همه" ActionLink="/portfolio" />

<MudGrid Class="mb-4">
    <MudItem xs="12" sm="6" md="4" lg="3">
        <PortfolioCard />
    </MudItem>

    <MudItem xs="12" sm="6" md="4" lg="3">
        <PortfolioCard />
    </MudItem>
</MudGrid>

<MudPaper Class="pa-5 order-cta"
          Elevation="1">

    <div class="order-cta-header">

        <MudIcon Icon="@Icons.Material.Filled.ShoppingBag"
                 Color="Color.Primary"
                 Size="Size.Large" />

        <div class="order-cta-content">

            <MudText Typo="Typo.h6"
                     Class="fw-bold">
                سفارش ساخت اثر هنری
            </MudText>

            <MudText Typo="Typo.body2"
                     Color="Color.Secondary">
                عکس یا ایده‌ات را ارسال کن تا برایت مجسمه یا تابلوی اختصاصی ساخته شود.
            </MudText>

        </div>

    </div>

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               Href="/orders"
               FullWidth="true"
               Size="Size.Large"
               Class="mt-4">
        ثبت سفارش
    </MudButton>

</MudPaper>
