@page "/"

@using Marzi.Client.Core.Models.Courses
@using Marzi.Client.Core.Models.Portfolio
@using Marzi.Client.Infrastructure.Services
@using Marzi.Client.Shared.Components.Common
@using Marzi.Client.Shared.Components.Cards

@inject CourseService CourseService
@inject PortfolioService PortfolioService
@inject ISnackbar Snackbar

<PageTitle>Marzi Handicrafts</PageTitle>

<HeroBanner />

<MudText Typo="Typo.h5" Class="mb-2">
    سلام 🌸
</MudText>

<MudText Typo="Typo.body1"
         Color="Color.Secondary"
         Class="mb-6">

    امروز آماده‌ای یک اثر هنری جدید خلق کنیم؟

</MudText>

<!-- Courses -->

<SectionTitle Title="دوره‌های آموزشی"
              ActionText="همه"
              ActionLink="/courses" />

@if (_loadingCourses)
{
    <MudProgressCircular Color="Color.Primary"
                         Indeterminate="true" />
}
else if (_courses.Count == 0)
{
    <MudAlert Severity="Severity.Info">

        هنوز دوره‌ای منتشر نشده است.

    </MudAlert>
}
else
{
    <MudGrid Class="mb-6">

        @foreach (var course in _courses.Take(2))
        {
            <MudItem xs="12"
                     sm="6"
                     md="4">

                <CourseCard Course="course" />

            </MudItem>
        }

    </MudGrid>
}

<!-- Portfolio -->

<SectionTitle Title="نمونه کارها"
              ActionText="همه"
              ActionLink="/portfolio" />

@if (_loadingPortfolio)
{
    <MudProgressCircular Color="Color.Primary"
                         Indeterminate="true" />
}
else if (_portfolio.Count == 0)
{
    <MudAlert Severity="Severity.Info">

        هنوز نمونه کاری منتشر نشده است.

    </MudAlert>
}
else
{
    <MudGrid Class="mb-6">

        @foreach (var item in _portfolio.Take(2))
        {
            <MudItem xs="12"
                     sm="6"
                     md="4">

                <PortfolioCard Item="item" />

            </MudItem>
        }

    </MudGrid>
}

<MudPaper Class="pa-5 order-cta"
          Elevation="1">

    <MudText Typo="Typo.h6"
             Class="mb-2">

        سفارش ساخت اثر هنری

    </MudText>

    <MudText Typo="Typo.body2"
             Color="Color.Secondary">

        اگر ایده‌ای در ذهن داری، برای ما ارسال کن تا به یک اثر هنری خاص تبدیل شود.

    </MudText>

    <MudButton Class="mt-4"
               Variant="Variant.Filled"
               Color="Color.Primary"
               FullWidth="true"
               Href="/orders">

        ثبت سفارش

    </MudButton>

</MudPaper>

@code {

    private IReadOnlyList<CourseDto> _courses = []
        ;

    private IReadOnlyList<PortfolioItemDto> _portfolio = []
        ;

    private bool _loadingCourses = true;

    private bool _loadingPortfolio = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadCourses();

        await LoadPortfolio();
    }

    private async Task LoadCourses()
    {
        try
        {
            _courses =
                await CourseService.GetPublishedAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                ex.Message,
                Severity.Error);
        }
        finally
        {
            _loadingCourses = false;
        }
    }

    private async Task LoadPortfolio()
    {
        try
        {
            _portfolio =
                await PortfolioService.GetPublishedAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                ex.Message,
                Severity.Error);
        }
        finally
        {
            _loadingPortfolio = false;
        }
    }

}

