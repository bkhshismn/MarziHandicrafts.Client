@page "/contact"

@using Marzi.Client.Core.Interfaces
@using Marzi.Client.Core.Models
@using Marzi.Client.Infrastructure.Api
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

<SeoHead Title="تماس با مرزی | سفارش هنرهای دستی در مازندران" Path="/contact"
         Description="برای سفارش ساخت اثر، دوره‌های آموزشی و گفتگو با کارگاه مرزی در جویبار، مازندران با ما در تماس باشید." />

@implements IAsyncDisposable

@inject IChatApi ChatApi
@inject ILocalStorage LocalStorage
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISnackbar Snackbar

@{
    const string phone = "+989119009567";
    const string address =
        "مازندران، جویبار، زرین‌کلا، خیابان ورزش، کوچه پونه، آموزشگاه آسمان";
    const string location = "36.724206,52.959262";
    var mapUrl = $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(location)}";
}

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6">

    <MudText Typo="Typo.h3" Class="mb-2">تماس با ما</MudText>

    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
        برای سفارش، مشاوره یا هر سؤالی دربارهٔ دوره‌ها، از راه‌های زیر با ما در تماس باشید.
    </MudText>

    <MudGrid Spacing="4">

        <!-- Contact options -->
        <MudItem xs="12" md="5">

            <MudPaper Class="contact-option-card mb-3" Elevation="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <span class="contact-icon contact-icon-phone"><MudIcon Icon="@Icons.Material.Filled.Phone" /></span>
                    <div>
                        <MudText Typo="Typo.overline" Color="Color.Secondary">تماس مستقیم</MudText>
                        <MudText Typo="Typo.subtitle1" Class="contact-option-title">
                            <a href="@($"tel:{phone}")" dir="ltr">+98 911 900 9567</a>
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">برای سفارش و مشاوره</MudText>
                    </div>
                </MudStack>
            </MudPaper>

            <MudPaper Class="contact-option-card contact-option-whatsapp mb-3" Elevation="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <span class="contact-icon contact-icon-whatsapp" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.95 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.88 1.21 3.08c.15.2 2.09 3.2 5.07 4.49.71.31 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.05 2C6.55 2 2.1 6.45 2.1 11.95c0 1.76.46 3.45 1.32 4.93L2 22l5.25-1.38a9.9 9.9 0 0 0 4.8 1.22h.01c5.5 0 9.95-4.45 9.95-9.95S17.55 2 12.05 2Z" /></svg>
                    </span>
                    <div>
                        <MudText Typo="Typo.overline" Color="Color.Secondary">پاسخ‌گویی سریع</MudText>
                        <MudText Typo="Typo.subtitle1" Class="contact-option-title">
                            <a href="@($"https://wa.me/{phone.TrimStart('+')}")"
                               target="_blank"
                               rel="noopener">
                                گفتگو در واتس‌اپ <MudIcon Icon="@Icons.Material.Filled.ArrowOutward" Size="Size.Small" />
                            </a>
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">پیام خود را همین حالا بفرستید</MudText>
                    </div>
                </MudStack>
            </MudPaper>

            <MudPaper Class="contact-option-card mb-3" Elevation="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <span class="contact-icon contact-icon-telegram"><MudIcon Icon="@Icons.Material.Filled.Send" /></span>
                    <div>
                        <MudText Typo="Typo.overline" Color="Color.Secondary">شبکه‌های اجتماعی</MudText>
                        <MudText Typo="Typo.subtitle1" Class="contact-option-title">
                            <a href="@($"https://t.me/{phone}")"
                               target="_blank"
                               rel="noopener">
                                پیام در تلگرام <MudIcon Icon="@Icons.Material.Filled.ArrowOutward" Size="Size.Small" />
                            </a>
                        </MudText>
                    </div>
                </MudStack>
            </MudPaper>

            <MudPaper Class="contact-option-card mb-3" Elevation="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <span class="contact-icon contact-icon-instagram" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16Zm0 1.8c-3.14 0-3.5.01-4.74.07-1.15.05-1.77.24-2.18.4-.55.21-.94.47-1.35.88-.41.41-.67.8-.88 1.35-.16.41-.35 1.03-.4 2.18-.06 1.24-.07 1.6-.07 4.74s.01 3.5.07 4.74c.05 1.15.24 1.77.4 2.18.21.55.47.94.88 1.35.41.41.8.67 1.35.88.41.16 1.03.35 2.18.4 1.24.06 1.6.07 4.74.07s3.5-.01 4.74-.07c1.15-.05 1.77-.24 2.18-.4.55-.21.94-.47 1.35-.88.41-.41.67-.8.88-1.35.16-.41.3-1.03.4-2.18.06-1.24.07-1.6.07-4.74s-.01-3.5-.07-4.74c-.05-1.15-.24-1.77-.4-2.18a3.6 3.6 0 0 0-.88-1.35 3.6 3.6 0 0 0-1.35-.88c-.41-.16-1.03-.35-2.18-.4-1.24-.06-1.6-.07-4.74-.07Zm0 3.06a4.98 4.98 0 1 1 0 9.96 4.98 4.98 0 0 1 0-9.96Zm0 8.21a3.23 3.23 0 1 0 0-6.46 3.23 3.23 0 0 0 0 6.46Zm6.34-8.4a1.16 1.16 0 1 1-2.32 0 1.16 1.16 0 0 1 2.32 0Z" /></svg>
                    </span>
                    <div>
                        <MudText Typo="Typo.overline" Color="Color.Secondary">ما را دنبال کنید</MudText>
                        <MudText Typo="Typo.subtitle1" Class="contact-option-title">
                            <a href="https://www.instagram.com/marzi.handicrafts/"
                               target="_blank"
                               rel="noopener">
                                marzi.handicrafts <MudIcon Icon="@Icons.Material.Filled.ArrowOutward" Size="Size.Small" />
                            </a>
                        </MudText>
                    </div>
                </MudStack>
            </MudPaper>

            <MudPaper Class="contact-option-card contact-address-card" Elevation="1">
                <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="3">
                    <span class="contact-icon contact-icon-address"><MudIcon Icon="@Icons.Material.Filled.Place" /></span>
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">نشانی آموزشگاه</MudText>
                        <MudText Typo="Typo.body2" Class="mb-2">@address</MudText>
                        <MudButton Href="@mapUrl"
                                   Target="_blank"
                                   Variant="Variant.Text"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Map">
                            مسیریابی روی نقشه
                        </MudButton>
                    </div>
                </MudStack>
            </MudPaper>

        </MudItem>

        <!-- Chat -->
        <MudItem xs="12" md="7">

            <MudPaper Class="pa-4" Elevation="1">

                <MudText Typo="Typo.h6" Class="mb-1">گفتگو با مدیر</MudText>

                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                    پیام بگذارید؛ در اولین فرصت پاسخ می‌دهیم. صفحه را باز بگذارید تا پاسخ را همین‌جا ببینید.
                </MudText>

                <div class="chat-thread">
                    @if (_messages.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-2">
                            هنوز پیامی فرستاده نشده است.
                        </MudText>
                    }

                    @foreach (var message in _messages)
                    {
                        var isAdmin = string.Equals(message.SenderRole, "Admin", StringComparison.OrdinalIgnoreCase);

                        <div class="@(isAdmin ? "chat-row chat-row-admin" : "chat-row")">
                            <div class="@(isAdmin ? "chat-bubble chat-bubble-admin" : "chat-bubble")">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @(isAdmin ? message.SenderName : "شما")
                                    —
                                    @message.CreatedAt.ToLocalTime().ToString("HH:mm")
                                </MudText>
                                <MudText Typo="Typo.body2">@message.Body</MudText>
                            </div>
                        </div>
                    }
                </div>

                <MudGrid Spacing="2" Class="mt-2 mb-2">
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_name"
                                      Label="نام و نام خانوادگی"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Required="true"
                                      RequiredError="نام خود را وارد کنید."
                                      MaxLength="100" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_phone"
                                      Label="شمارهٔ موبایل"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      InputType="InputType.Telephone"
                                      dir="ltr"
                                      Required="true"
                                      RequiredError="شمارهٔ موبایل خود را وارد کنید."
                                      HelperText="برای پیگیری پاسخ، شماره‌تان لازم است."
                                      MaxLength="20" />
                    </MudItem>
                </MudGrid>

                <MudTextField @bind-Value="_draft"
                              Label="پیام شما"
                              Variant="Variant.Outlined"
                              Lines="3"
                              Class="mt-2"
                              MaxLength="2000" />

                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-2">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @(_messages.Count == 0 ? "" : $"{_messages.Count} پیام در این گفتگو")
                    </MudText>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Send"
                               Disabled="_sending"
                               OnClick="SendAsync">
                        @(_sending ? "در حال ارسال..." : "ارسال پیام")
                    </MudButton>
                </MudStack>

            </MudPaper>

        </MudItem>

    </MudGrid>

</MudContainer>

@code {
    private const string ConversationKey = "chat.conversation";

    private Guid _conversationId;

    private readonly List<ChatMessageDto> _messages = [];

    private string? _draft;

    private string? _name;

    private string? _phone;

    private bool _sending;

    private bool _isAuthenticated;

    private CancellationTokenSource? _polling;

    protected override async Task OnInitializedAsync()
    {
        var authState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        _isAuthenticated =
            authState.User.Identity?.IsAuthenticated == true;

        _name = _isAuthenticated
            ? authState.User.Identity?.Name ?? "کاربر"
            : null;

        _conversationId = await LoadConversationIdAsync();

        await LoadMessagesAsync();

        _polling = new CancellationTokenSource();

        _ = PollAsync(_polling.Token);
    }

    private async Task<Guid> LoadConversationIdAsync()
    {
        try
        {
            var stored =
                await LocalStorage.GetAsync<string>(ConversationKey);

            if (Guid.TryParse(stored, out var existing))
                return existing;
        }
        catch
        {
            // ignore
        }

        var created = Guid.NewGuid();

        try
        {
            await LocalStorage.SetAsync(ConversationKey, created.ToString());
        }
        catch
        {
            // ignore
        }

        return created;
    }

    private async Task PollAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(5), cancellationToken);

                if (cancellationToken.IsCancellationRequested)
                    break;

                var before = _messages.Count;

                await LoadMessagesAsync();

                if (_messages.Count != before)
                    await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // طبیعی است
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CHAT] Poll failed: {ex.Message}");
        }
    }

    private async Task LoadMessagesAsync()
    {
        try
        {
            var response =
                await ChatApi.GetMessagesAsync(_conversationId);

            if (!response.IsSuccessStatusCode || response.Content is null)
                return;

            _messages.Clear();
            _messages.AddRange(response.Content);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CHAT] Load failed: {ex.Message}");
        }
    }

    private async Task SendAsync()
    {
        if (_sending)
            return;

        var text = _draft?.Trim();

        if (string.IsNullOrWhiteSpace(text))
        {
            Snackbar.Add("متن پیام را بنویسید.", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_name) || _name.Trim().Length < 2)
        {
            Snackbar.Add("نام خود را وارد کنید.", Severity.Warning);
            return;
        }

        if (!IsValidIranianMobile(_phone))
        {
            Snackbar.Add("شمارهٔ موبایل معتبر وارد کنید.", Severity.Warning);
            return;
        }

        _sending = true;

        try
        {
            var response =
                await ChatApi.SendAsync(new SendChatMessageRequest
                {
                    ConversationId = _conversationId,
                    Name = _name?.Trim() ?? "مهمان",
                    Phone = _phone?.Trim(),
                    Body = text
                });

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("ارسال پیام انجام نشد.", Severity.Error);
                return;
            }

            _draft = string.Empty;

            await LoadMessagesAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _sending = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string DigitsOf(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return string.Empty;

        return new string(value
            .Where(char.IsDigit)
            .Select(character => (char)('0' + char.GetNumericValue(character)))
            .ToArray());
    }

    private static bool IsValidIranianMobile(string? value)
    {
        var digits = DigitsOf(value);
        if (digits.StartsWith("0098", StringComparison.Ordinal))
            digits = digits[2..];
        if (digits.StartsWith("98", StringComparison.Ordinal) && digits.Length == 12)
            digits = "0" + digits[2..];

        return digits.Length == 11 && digits.StartsWith("09", StringComparison.Ordinal);
    }

    public ValueTask DisposeAsync()
    {
        _polling?.Cancel();
        _polling?.Dispose();

        return ValueTask.CompletedTask;
    }
}
