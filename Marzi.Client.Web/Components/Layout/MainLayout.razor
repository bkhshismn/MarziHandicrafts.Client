@inherits LayoutComponentBase

@using MudBlazor
@using Marzi.Client.Shared.Components.Navigation
@using Marzi.Client.Shared.Theme
@using Microsoft.AspNetCore.Components.Authorization

<MudRTLProvider RightToLeft="true">

    <MudThemeProvider Theme="@AppTheme.Default" />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    <MudLayout>

        <MudAppBar Elevation="1"
                   Color="Color.Primary"
                   Class="marzi-appbar">

            <MudText Typo="Typo.h6"
                     Class="brand-title">
                Marzi Handicrafts
            </MudText>

            <MudSpacer />

            <div class="desktop-navigation">

                <MudButton Href="/"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.Home">
                    خانه
                </MudButton>

                <MudButton Href="/courses"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.School">
                    دوره‌ها
                </MudButton>

                <MudButton Href="/portfolio"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.Palette">
                    نمونه‌کارها
                </MudButton>

                <MudButton Href="/orders"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.ShoppingBag">
                    سفارش
                </MudButton>

                <MudButton Href="/profile"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.Person">
                    پروفایل
                </MudButton>

            </div>

            <MudIconButton Icon="@Icons.Material.Filled.Notifications"
                           Color="Color.Inherit" />

        </MudAppBar>


        <MudMainContent>

            <main class="main-content">
                @Body
            </main>

        </MudMainContent>


        <div class="mobile-bottom-navigation">
            <BottomNavigation />
        </div>

    </MudLayout>

</MudRTLProvider>